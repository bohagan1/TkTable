.TH "tkTable" n 2\&.12 tkTable "TkTable extension"
.\" The -*- nroff -*- definitions below are for supplemental macros used
.\" in Tcl/Tk manual entries.
.\"
.\" .AP type name in/out ?indent?
.\"	Start paragraph describing an argument to a library procedure.
.\"	type is type of argument (int, etc.), in/out is either "in", "out",
.\"	or "in/out" to describe whether procedure reads or modifies arg,
.\"	and indent is equivalent to second arg of .IP (shouldn't ever be
.\"	needed;  use .AS below instead)
.\"
.\" .AS ?type? ?name?
.\"	Give maximum sizes of arguments for setting tab stops.  Type and
.\"	name are examples of largest possible arguments that will be passed
.\"	to .AP later.  If args are omitted, default tab stops are used.
.\"
.\" .BS
.\"	Start box enclosure.  From here until next .BE, everything will be
.\"	enclosed in one large box.
.\"
.\" .BE
.\"	End of box enclosure.
.\"
.\" .CS
.\"	Begin code excerpt.
.\"
.\" .CE
.\"	End code excerpt.
.\"
.\" .VS ?version? ?br?
.\"	Begin vertical sidebar, for use in marking newly-changed parts
.\"	of man pages.  The first argument is ignored and used for recording
.\"	the version when the .VS was added, so that the sidebars can be
.\"	found and removed when they reach a certain age.  If another argument
.\"	is present, then a line break is forced before starting the sidebar.
.\"
.\" .VE
.\"	End of vertical sidebar.
.\"
.\" .DS
.\"	Begin an indented unfilled display.
.\"
.\" .DE
.\"	End of indented unfilled display.
.\"
.\" .SO ?manpage?
.\"	Start of list of standard options for a Tk widget. The manpage
.\"	argument defines where to look up the standard options; if
.\"	omitted, defaults to "options". The options follow on successive
.\"	lines, in three columns separated by tabs.
.\"
.\" .SE
.\"	End of list of standard options for a Tk widget.
.\"
.\" .OP cmdName dbName dbClass
.\"	Start of description of a specific option.  cmdName gives the
.\"	option's name as specified in the class command, dbName gives
.\"	the option's name in the option database, and dbClass gives
.\"	the option's class in the option database.
.\"
.\" .UL arg1 arg2
.\"	Print arg1 underlined, then print arg2 normally.
.\"
.\" .QW arg1 ?arg2?
.\"	Print arg1 in quotes, then arg2 normally (for trailing punctuation).
.\"
.\" .PQ arg1 ?arg2?
.\"	Print an open parenthesis, arg1 in quotes, then arg2 normally
.\"	(for trailing punctuation) and then a closing parenthesis.
.\"
.\"	# Set up traps and other miscellaneous stuff for Tcl/Tk man pages.
.if t .wh -1.3i ^B
.nr ^l \n(.l
.ad b
.\"	# Start an argument description
.de AP
.ie !"\\$4"" .TP \\$4
.el \{\
.   ie !"\\$2"" .TP \\n()Cu
.   el          .TP 15
.\}
.ta \\n()Au \\n()Bu
.ie !"\\$3"" \{\
\&\\$1 \\fI\\$2\\fP (\\$3)
.\".b
.\}
.el \{\
.br
.ie !"\\$2"" \{\
\&\\$1	\\fI\\$2\\fP
.\}
.el \{\
\&\\fI\\$1\\fP
.\}
.\}
..
.\"	# define tabbing values for .AP
.de AS
.nr )A 10n
.if !"\\$1"" .nr )A \\w'\\$1'u+3n
.nr )B \\n()Au+15n
.\"
.if !"\\$2"" .nr )B \\w'\\$2'u+\\n()Au+3n
.nr )C \\n()Bu+\\w'(in/out)'u+2n
..
.AS Tcl_Interp Tcl_CreateInterp in/out
.\"	# BS - start boxed text
.\"	# ^y = starting y location
.\"	# ^b = 1
.de BS
.br
.mk ^y
.nr ^b 1u
.if n .nf
.if n .ti 0
.if n \l'\\n(.lu\(ul'
.if n .fi
..
.\"	# BE - end boxed text (draw box now)
.de BE
.nf
.ti 0
.mk ^t
.ie n \l'\\n(^lu\(ul'
.el \{\
.\"	Draw four-sided box normally, but don't draw top of
.\"	box if the box started on an earlier page.
.ie !\\n(^b-1 \{\
\h'-1.5n'\L'|\\n(^yu-1v'\l'\\n(^lu+3n\(ul'\L'\\n(^tu+1v-\\n(^yu'\l'|0u-1.5n\(ul'
.\}
.el \}\
\h'-1.5n'\L'|\\n(^yu-1v'\h'\\n(^lu+3n'\L'\\n(^tu+1v-\\n(^yu'\l'|0u-1.5n\(ul'
.\}
.\}
.fi
.br
.nr ^b 0
..
.\"	# VS - start vertical sidebar
.\"	# ^Y = starting y location
.\"	# ^v = 1 (for troff;  for nroff this doesn't matter)
.de VS
.if !"\\$2"" .br
.mk ^Y
.ie n 'mc \s12\(br\s0
.el .nr ^v 1u
..
.\"	# VE - end of vertical sidebar
.de VE
.ie n 'mc
.el \{\
.ev 2
.nf
.ti 0
.mk ^t
\h'|\\n(^lu+3n'\L'|\\n(^Yu-1v\(bv'\v'\\n(^tu+1v-\\n(^Yu'\h'-|\\n(^lu+3n'
.sp -1
.fi
.ev
.\}
.nr ^v 0
..
.\"	# Special macro to handle page bottom:  finish off current
.\"	# box/sidebar if in box/sidebar mode, then invoked standard
.\"	# page bottom macro.
.de ^B
.ev 2
'ti 0
'nf
.mk ^t
.if \\n(^b \{\
.\"	Draw three-sided box if this is the box's first page,
.\"	draw two sides but no top otherwise.
.ie !\\n(^b-1 \h'-1.5n'\L'|\\n(^yu-1v'\l'\\n(^lu+3n\(ul'\L'\\n(^tu+1v-\\n(^yu'\h'|0u'\c
.el \h'-1.5n'\L'|\\n(^yu-1v'\h'\\n(^lu+3n'\L'\\n(^tu+1v-\\n(^yu'\h'|0u'\c
.\}
.if \\n(^v \{\
.nr ^x \\n(^tu+1v-\\n(^Yu
\kx\h'-\\nxu'\h'|\\n(^lu+3n'\ky\L'-\\n(^xu'\v'\\n(^xu'\h'|0u'\c
.\}
.bp
'fi
.ev
.if \\n(^b \{\
.mk ^y
.nr ^b 2
.\}
.if \\n(^v \{\
.mk ^Y
.\}
..
.\"	# DS - begin display
.de DS
.RS
.nf
.sp
..
.\"	# DE - end display
.de DE
.fi
.RE
.sp
..
.\"	# SO - start of list of standard options
.de SO
'ie '\\$1'' .ds So \\fBoptions\\fR
'el .ds So \\fB\\$1\\fR
.SH "STANDARD OPTIONS"
.LP
.nf
.ta 5.5c 11c
.ft B
..
.\"	# SE - end of list of standard options
.de SE
.fi
.ft R
.LP
See the \\*(So manual entry for details on the standard options.
..
.\"	# OP - start of full description for a single option
.de OP
.LP
.nf
.ta 4c
Command-Line Name:	\\fB\\$1\\fR
Database Name:	\\fB\\$2\\fR
Database Class:	\\fB\\$3\\fR
.fi
.IP
..
.\"	# CS - begin code excerpt
.de CS
.RS
.nf
.ta .25i .5i .75i 1i
..
.\"	# CE - end code excerpt
.de CE
.fi
.RE
..
.\"	# UL - underline word
.de UL
\\$1\l'|0\(ul'\\$2
..
.\"	# QW - apply quotation marks to word
.de QW
.ie '\\*(lq'"' ``\\$1''\\$2
.\"" fix emacs highlighting
.el \\*(lq\\$1\\*(rq\\$2
..
.\"	# PQ - apply parens and quotation marks to word
.de PQ
.ie '\\*(lq'"' (``\\$1''\\$2)\\$3
.\"" fix emacs highlighting
.el (\\*(lq\\$1\\*(rq\\$2)\\$3
..
.\"	# QR - quoted range
.de QR
.ie '\\*(lq'"' ``\\$1''\\-``\\$2''\\$3
.\"" fix emacs highlighting
.el \\*(lq\\$1\\*(rq\\-\\*(lq\\$2\\*(rq\\$3
..
.\"	# MT - "empty" string
.de MT
.QW ""
..
.BS
.SH NAME
tkTable \- Create and manipulate table widgets
.SH SYNOPSIS
package require \fBTcl ?8\&.5-?\fR
.sp
package require \fBTktable ?2\&.12?\fR
.sp
\fBtable\fR \fIpathName\fR ?\fIoptions\fR?
.sp
\fBtk_tableCopy\fR \fIpathName\fR
.sp
\fBtk_tableCut\fR \fIpathName\fR
.sp
\fBtk_tablePaste\fR \fIpathName\fR ?\fIcell\fR?
.sp
.BE
.SH DESCRIPTION
.TP
\fBtable\fR \fIpathName\fR ?\fIoptions\fR?
Creates and configures a table widget with name \fIpathName\fR\&.
Additional options may be specified on the command line or
in the option database to configure aspects of the table such as its background
color and relief\&. The \fBtable\fR command returns the path name of the new
window\&. At the time the command is invoked, \fIpathName\fR must not exist,
but it's parent must\&.
The \fBtable\fR command creates a 2-dimensional grid of cells\&.  The table
can use a TCL array variable or TCL command for data storage and retrieval,
as well as an optional data cache in memory for speed\&.  The default variable is
\fB::tableData\fR\&. The widget has an active cell, the contents of which can be
edited (when the state is normal) and a focus cell which is used for keyboard
navigation between cells\&.  The widget supports a default style for
the cells and also multiple tags which can be used to change the style of a
row, column, or cell (see \fBTAGS\fR for details)\&.  A cell flash can
also be set so that edited cells will change colors for a specified amount of
time ("blink")\&.  Cells can have embedded images or windows, as described in
\fBTAGS\fR and \fBEMBEDDED WINDOWS\fR respectively\&.
.sp
One or more cells may be selected as described below\&.  If a table is
exporting its selection (see \fB-exportselection\fR option), then it will
observe the standard X11 protocols for handling the selection\&.  See
\fBTHE SELECTION\fR for details\&.
.sp
It is not necessary for all the cells to be displayed in the table window at
once; commands described below may be used to change the view in the window\&.
Tables allow scrolling in both directions using the standard
\fB-xscrollcommand\fR and \fB-yscrollcommand\fR options\&.  They also support
scanning, as described below\&.
.sp
In order to obtain good performance, the table widget supports multiple
drawing modes, two of which are fully Tk compatible\&.
.TP
\fBtk_tableCopy\fR \fIpathName\fR
Copies the contents of selection in the active cell or if none, the selected
cells in \fIpathName\fR to the clipboard\&.
This is used by the \fB<<Copy>>\fR virtual event\&.
.TP
\fBtk_tableCut\fR \fIpathName\fR
Copies contents of selection in the active cell or if none, the selected cells
in \fIpathName\fR to the clipboard, deletes the selected text or cells, and
clears the selection\&. This is used by the \fB<<Cut>>\fR virtual event\&.
.TP
\fBtk_tablePaste\fR \fIpathName\fR ?\fIcell\fR?
Pastes the contents of the clipboard into table \fIpathName\fR\&. If there is an
active cell, the clipboard contents will be pasted into the active cell at the
insertion cursor location replacing any selected text\&. If not, the cell values
will be replaced by the pasted values starting at cell \fIcell\fR or the active
cell if not specified\&. This is used by the \fB<<Paste>>\fR virtual event\&.
.PP
.SH "STANDARD OPTIONS"
.TP
\fB\fB-background\fR\fR
.TP
\fB\fB-cursor\fR\fR
.TP
\fB\fB-exportselection\fR\fR
.TP
\fB\fB-font\fR\fR
.TP
\fB\fB-foreground\fR\fR
.TP
\fB\fB-highlightbackground\fR\fR
.TP
\fB\fB-highlightcolor\fR\fR
.TP
\fB\fB-highlightthickness\fR\fR
.TP
\fB\fB-insertbackground\fR\fR
.TP
\fB\fB-insertborderwidth\fR\fR
.TP
\fB\fB-insertofftime\fR\fR
.TP
\fB\fB-insertontime\fR\fR
.TP
\fB\fB-insertwidth\fR\fR
.TP
\fB\fB-relief\fR\fR
.TP
\fB\fB-selectbackground\fR\fR
.TP
\fB\fB-selectborderwidth\fR\fR
.TP
\fB\fB-selectforeground\fR\fR
.TP
\fB\fB-takefocus\fR\fR
.TP
\fB\fB-xscrollcommand\fR\fR
.TP
\fB\fB-yscrollcommand\fR\fR
.PP
See the \fBoptions\fR manual entry for details on the standard options\&.
.SH "WIDGET SPECIFIC OPTIONS"
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-anchor\fR
Database Name:	\fBanchor\fR
Database Class:	\fBAnchor\fR

.fi
.IP
Defines how to position text, image, or window within a cell\&. Must be one of
the values \fBn\fR, \fBne\fR, \fBe\fR, \fBse\fR, \fBs\fR, \fBsw\fR,
\fBw\fR, \fBnw\fR, or \fBcenter\fR\&. Defaults to \fBcenter\fR\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-autoclear\fR
Database Name:	\fBautoClear\fR
Database Class:	\fBAutoClear\fR

.fi
.IP
A boolean value which specifies whether the first keypress in a cell will
delete whatever text was previously there\&.  Defaults to 0\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-bordercursor\fR
Database Name:	\fBborderCursor\fR
Database Class:	\fBCursor\fR

.fi
.IP
Specifies the name of the cursor to show when over borders, a visual
indication that interactive resizing is allowed (it is thus affect by
the value of \fBresizeborders\fR)\&.  Defaults to \fBcrosshair\fR\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-borderwidth or -bd\fR
Database Name:	\fBborderWidth\fR
Database Class:	\fBBorderWidth\fR

.fi
.IP
Specifies a non-negative pixel value or list of values indicating the width
of the 3-D border to draw on interior table cells (if such a border is
being drawn; the \fB-relief\fR option typically determines this)\&.  If one
value is specified, a rectangle of this width will be drawn\&.  If two values
are specified, then only the left and right edges of the cell will have
borders\&.  If four values are specified, then the values correspond to the
{left right top bottom} edges\&.  This can be overridden by the a tag's
borderwidth option\&.  It can also be affected by the defined
\fB-drawmode\fR for the table\&.  Each value in the list must have one of
the forms acceptable to \fBTk_GetPixels\fR\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-browsecommand or -browsecmd\fR
Database Name:	\fBbrowseCommand\fR
Database Class:	\fBBrowseCommand\fR

.fi
.IP
Specifies a command which will be evaluated anytime the active cell changes\&.
It uses the % substitution model described in \fBCOMMAND SUBSTITUTION\fR below\&.
Any changes to the active cell while the command is running are ignored to
prevent recursion\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-cache\fR
Database Name:	\fBcache\fR
Database Class:	\fBCache\fR

.fi
.IP
A boolean value that specifies whether an internal cache of the table
contents should be kept\&.  This greatly enhances speed performance when used
with \fB-command\fR but uses extra memory\&.  Can maintain state when both
\fB-command\fR and \fB-variable\fR are empty\&.  The cache is automatically
flushed whenever the value of \fB-cache\fR or \fB-variable\fR changes,
otherwise you have to explicitly call \fBclear\fR on it\&.  Defaults to off\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-colorigin\fR
Database Name:	\fBcolOrigin\fR
Database Class:	\fBOrigin\fR

.fi
.IP
Specifies what column index to interpret as the leftmost column in the table\&.
This value is used for user indices in the table\&.  Defaults to 0\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-cols\fR
Database Name:	\fBcols\fR
Database Class:	\fBCols\fR

.fi
.IP
Number of cols in the table\&.  Defaults to 10\&. The minimum value is 1\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-colseparator\fR
Database Name:	\fBcolSeparator\fR
Database Class:	\fBSeparator\fR

.fi
.IP
Specifies the separator character that will be used as the column separator
when cutting or pasting data in a table\&.  The default is the tab character\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-colstretchmode\fR
Database Name:	\fBcolStretchMode\fR
Database Class:	\fBStretchMode\fR

.fi
.IP
Specifies one of the following stretch modes for columns to fill extra
allocated window space:
.RS
.TP
\fBnone\fR
Columns will not stretch to fill the assigned window space\&.  If the columns
are too narrow, there will be a blank space at the right of the table\&.  This
is the default\&.
.TP
\fBunset\fR
Only columns that do not have a specific width set will be stretched\&.
.TP
\fBall\fR
All columns will be stretched by the same number of pixels to fill the
window space allocated to the table\&.  This mode can interfere with
interactive border resizing which tries to force column width\&.
.TP
\fBlast\fR
The last column will be stretched
to fill the window space allocated to the table\&.
.TP
\fBfill\fR
(only valid for \fB-rowstretch\fR currently)
The table will get more or less columns according to the window
space allocated to the table\&.  This mode has numerous quirks and
may disappear in the future\&.
.RE
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-coltagcommand\fR
Database Name:	\fBcolTagCommand\fR
Database Class:	\fBTagCommand\fR

.fi
.IP
Provides the name of a procedure that will be evaluated by the widget to
determine the tag to be used for a given column\&.  When displaying a cell,
the table widget will first check to see if a tag has been defined using the
\fBtag col\fR widget command\&.  If no tag is found, it will evaluate the named
procedure passing the column number in question as the sole argument\&.  The
procedure is expected to return the name of a tag to use, or a null string\&.
Errors occurring during the evaluation of the procedure, or the return of an
invalid tag name are silently ignored\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-colwidth\fR
Database Name:	\fBcolWidth\fR
Database Class:	\fBColWidth\fR

.fi
.IP
Default column width, interpreted as characters in the default font when
the number is positive, or pixels if it is negative\&.  Defaults to 10\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-command\fR
Database Name:	\fBcommand\fR
Database Class:	\fBCommand\fR

.fi
.IP
Specified a command to use as a procedural interface to cell values\&.
If \fB-usecommand\fR is true, this command will be used instead of any
reference to the \fB-variable\fR array\&.  When retrieving cell values,
the return value of the command is used as the value for the cell\&.
It uses the % substitution model described in \fBCOMMAND SUBSTITUTION\fR below\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-drawmode\fR
Database Name:	\fBdrawMode\fR
Database Class:	\fBDrawMode\fR

.fi
.IP
Sets the table drawing mode to one of the following options:
.RS
.TP
\fBslow\fR
The table is drawn to an offscreen pixmap using the Tk bordering functions
(double-buffering)\&.  This means there will be no flashing, but this mode is
slow for larger tables\&.
.TP
\fBcompatible\fR
The table is drawn directly to the screen using the Tk border functions\&.
It is faster, but the screen may flash on update\&.  This is the default\&.
.TP
\fBfast\fR
The table is drawn directly to the screen and the borders are done with
fast X calls, so they are always one pixel wide only\&.  As a side effect, it
restricts \fB-borderwidth\fR to a range of 0 or 1\&.  This mode provides
best performance for large tables, but can flash on redraw and is not 100%
Tk compatible on the border mode\&.
.TP
\fBsingle\fR
The table is drawn to the screen as in fast mode, but only single pixel
lines are drawn (not square borders)\&.
.RE
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-ellipsis\fR
Database Name:	\fBellipsis\fR
Database Class:	\fBEllipsis\fR

.fi
.IP
This specifies a string to display at the end of a line that would be
clipped by its cell, like "\&.\&.\&."\&.  An ellipsis will be displayed only
on non-wrapping, non-multiline cells that would be clipped\&.  The ellipsis
will display on the left for east anchored cells, otherwise it displays
on the right\&.
Defaults to "" (no ellipsis)\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-flashmode\fR
Database Name:	\fBflashMode\fR
Database Class:	\fBFlashMode\fR

.fi
.IP
A boolean value which specifies whether cells should flash when their value
changes\&.  The table tag \fBflash\fR will be applied to these cells for the
duration specified by \fB-flashtime\fR\&.  Defaults to 0\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-flashtime\fR
Database Name:	\fBflashTime\fR
Database Class:	\fBFlashTime\fR

.fi
.IP
The amount of time, in 1/4 second increments, for which a cell should flash
when its value has changed\&.  \fB-flashmode\fR must be on\&.  Defaults to 2\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-height\fR
Database Name:	\fBheight\fR
Database Class:	\fBHeight\fR

.fi
.IP
Specifies the desired height for the window, in rows\&.
If zero or less, then the desired height for the window is made just
large enough to hold all the rows in the table\&.  The height can be
further limited by \fB-maxheight\fR\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-invertselected\fR
Database Name:	\fBinvertSelected\fR
Database Class:	\fBInvertSelected\fR

.fi
.IP
Specifies whether the foreground and background of an item should simply
have their values swapped instead of merging the \fBsel\fR tag options
when the cell is selected\&.  Defaults to 0 (merge \fBsel\fR tag)\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-ipadx\fR
Database Name:	\fBipadX\fR
Database Class:	\fBPad\fR

.fi
.IP
A pixel value specifying the internal offset X padding for text in a cell\&.
This value does not grow the size of the cell, it just causes the text to
be drawn further from the cell border\&.  It only affects one side (depending
on anchor)\&.  Defaults to 0\&.  See \fB-padx\fR for an alternate padding
style\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-ipady\fR
Database Name:	\fBipadY\fR
Database Class:	\fBPad\fR

.fi
.IP
A pixel value specifying the internal offset Y padding for text in a cell\&.
This value does not grow the size of the cell, it just causes the text to
be drawn further from the cell border\&.  It only affects one side (depending
on anchor)\&.  Defaults to 0\&.  See \fB-pady\fR for an alternate padding
style\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-justify\fR
Database Name:	\fBjustify\fR
Database Class:	\fBJustify\fR

.fi
.IP
When there are multiple lines of text displayed in a cell, this option
determines how the lines line up with each other\&. Must be one of \fBleft\fR,
\fBcenter\fR, or \fBright\fR\&. The default is \fBleft\fR\&. Left means
that the lines' left edges all line up, center means that the lines' centers
are aligned, and right means that the lines' right edges line up\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-maxheight\fR
Database Name:	\fBmaxHeight\fR
Database Class:	\fBMaxHeight\fR

.fi
.IP
The max height in pixels that the window will request\&.  Defaults to 600\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-maxwidth\fR
Database Name:	\fBmaxWidth\fR
Database Class:	\fBMaxWidth\fR

.fi
.IP
The max width in pixels that the window will request\&.  Defaults to 800\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-mode\fR
Database Name:	\fBmode\fR
Database Class:	\fBMode\fR

.fi
.IP
Controls how bindings work for cell activation\&. The options are
\fBtable\fR or \fBspreadsheet\fR\&. The default value is \fBtable\fR\&.
For \fBtable\fR, a Button 1 press in a cell will activate it\&.
For \fBspreadsheet\fR, the first Button 1 press will only give a cell the
focus\&. The second Button 1 press will activate it\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-multiline\fR
Database Name:	\fBmultiline\fR
Database Class:	\fBMultiline\fR

.fi
.IP
Specifies the default setting for the multiline tag option\&.  Defaults to 1\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-padx\fR
Database Name:	\fBpadX\fR
Database Class:	\fBPad\fR

.fi
.IP
A pixel value specifying the offset X padding for a cell\&.  This value
causes the default size of the cell to increase by two times the value (one
for each side), unless a specific pixel size is chosen for the cell with
the \fBwidth\fR command\&.  This will force an empty area on the left and
right of each cell edge\&.  This padding affects all types of data in the
cell\&.  Defaults to 0\&.  See \fB-ipadx\fR for an alternate padding style\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-pady\fR
Database Name:	\fBpadY\fR
Database Class:	\fBPad\fR

.fi
.IP
A pixel value specifying the offset Y padding for a cell\&.  This value
causes the default size of the cell to increase by two times the value (one
for each side), unless a specific pixel size is chosen for the cell with
the \fBheight\fR command\&.  This will force an empty area on the top and
bottom of each cell edge\&.  This padding affects all types of data in the
cell\&.  Defaults to 0\&.  See \fB-ipadx\fR for an alternate padding style\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-quotechar\fR
Database Name:	\fBquoteCharacter\fR
Database Class:	\fBSeparator\fR

.fi
.IP
Specifies the delimiter character that will be used to quote cell text that
contains special characters when cutting and pasting data in a table\&.
The default is the quote character\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-resizeborders\fR
Database Name:	\fBresizeBorders\fR
Database Class:	\fBResizeBorders\fR

.fi
.IP
Specifies what kind of interactive border resizing to allow, must be one of
row, col, both (default) or none\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-rowheight\fR
Database Name:	\fBrowHeight\fR
Database Class:	\fBRowHeight\fR

.fi
.IP
Default row height, interpreted as lines in the default font when
the number is positive, or pixels if it is negative\&.  Defaults to 1\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-roworigin\fR
Database Name:	\fBrowOrigin\fR
Database Class:	\fBOrigin\fR

.fi
.IP
Specifies what row index to interpret as the topmost row in the table\&.
This value is used for user indices in the table\&.  Defaults to 0\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-rows\fR
Database Name:	\fBrows\fR
Database Class:	\fBRows\fR

.fi
.IP
Number of rows in the table\&.  Defaults to 10\&. The minimum value is 1\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-rowseparator\fR
Database Name:	\fBrowSeparator\fR
Database Class:	\fBSeparator\fR

.fi
.IP
Specifies the separator character that will be used as the row separator when
cutting or pasting data in a table\&.  The default is the newline character\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-rowstretchmode\fR
Database Name:	\fBrowStretchMode\fR
Database Class:	\fBStretchMode\fR

.fi
.IP
Specifies the stretch modes for rows to fill extra
allocated window space\&.  See \fB-colstretchmode\fR for valid options\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-rowtagcommand\fR
Database Name:	\fBrowTagCommand\fR
Database Class:	\fBTagCommand\fR

.fi
.IP
Provides the name of a procedure that can evaluated by the widget to
determine the tag to be used for a given row\&.  The procedure must be
defined by the user to accept a single argument (the row number), and
return a tag name or null string\&.  This operates in a similar manner as
\fB-coltagcommand\fR, except that it applies to row tags\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-selectioncommand or -selcmd\fR
Database Name:	\fBselectionCommand\fR
Database Class:	\fBSelectionCommand\fR

.fi
.IP
Specifies a command to evaluate when the selection is retrieved from a
table via the selection mechanism (ie: evaluating \fBselection get\fR)\&.
The return value from this command will become the string passed on by the
selection mechanism\&.  It uses the % substitution model described in
\fBCOMMAND SUBSTITUTION\fR below\&.  If an error occurs, a TCL background
error is generated and nothing is returned\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-selectmode\fR
Database Name:	\fBselectMode\fR
Database Class:	\fBSelectMode\fR

.fi
.IP
Controls how the built-in class bindings manage the selection\&.  The value
of the option may be arbitrary, but the default bindings expect it to be
either \fBsingle\fR, \fBbrowse\fR, \fBmultiple\fR, or \fBextended\fR\&.
The default value is \fBbrowse\fR\&.  These options work the same as the Tk
listbox, except expanded for 2 dimensions\&.
.RS
.TP
\fBbrowse\fR
Only one cell will be selected at a time\&. The selection follows the mouse
pointer when Button-1 is pressed and the cell focus during keyboard traversal\&.
In this mode, the selection cannot be removed via the keyboard bindings\&.
.TP
\fBsingle\fR
Only a single cell can be selected at a time\&. Cells are selected via Button-1\&.
Selecting a cell unselects all other cells\&. In this mode, the selection does
not follow the mouse pointer when Button-1 is pressed nor the cell focus during
keyboard traversal\&. The selection can be cleared via the keyboard bindings\&.
.TP
\fBmultiple\fR
Multiple cells can be selected at a time\&. Selecting a cell does not change the
selection state of other cells\&. Selecting a cell that is already selected will
unselect it\&. In this mode, the focus and selection are independent which allows
for keyboard traversal without changing the selection\&.
The selection can be cleared via the keyboard bindings\&.
.TP
\fBextended\fR
Multiple cells can be selected, but the default is for only one cell to be
selected at a time\&. More cells can be selected by dragging the mouse pointer
with Button-1 is pressed or by extending the selection using the Shift key
bindings\&. In this mode, the selection follows the focus during keyboard
traversal\&. The selection can be cleared via the keyboard bindings\&.
.RE
.IP
Note that the \fBselection\fR method can set the selection to include any
cell regardless of the value of \fB-selectmode\fR\&. This mode also doesn't
impact the \fBselection active\fR controlled active cell selection\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-selecttitles\fR
Database Name:	\fBselectTitles\fR
Database Class:	\fBSelectTitles\fR

.fi
.IP
Specifies whether title cells should be allowed in the selection\&.
Defaults to 0, not allowed\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-selecttype\fR
Database Name:	\fBselectType\fR
Database Class:	\fBSelectType\fR

.fi
.IP
Specifies one of several types of selection for the table\&.  The value of the
option may be one of \fBrow\fR, \fBcol\fR, \fBcell\fR, or \fBboth\fR
(meaning row && col); the default value is \fBcell\fR\&.  These types
define whether an entire row/col is affected when a cell's selection is
changed (set or clear)\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-sparsearray\fR
Database Name:	\fBsparseArray\fR
Database Class:	\fBSparseArray\fR

.fi
.IP
A boolean value that specifies whether an associated TCL array should be
kept as a sparse array (1, the default) or as a full array (0)\&.  If true,
then cell values that are empty will be deleted from the array (taking
less memory)\&.  If false, then all values in the array will be maintained\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-state\fR
Database Name:	\fBstate\fR
Database Class:	\fBState\fR

.fi
.IP
Specifies one of two states for the entry: \fBnormal\fR or \fBdisabled\fR\&.
If the table is disabled then the value may not be changed using widget
commands and no insertion cursor will be displayed, even if the input focus
is in the widget\&.  Also, all insert or delete methods will be ignored\&.
Defaults to \fBnormal\fR\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-titlecols\fR
Database Name:	\fBtitleCols\fR
Database Class:	\fBTitleCols\fR

.fi
.IP
Number of columns to use as a title area\&.  Defaults to 0\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-titlerows\fR
Database Name:	\fBtitleRows\fR
Database Class:	\fBTitleRows\fR

.fi
.IP
Number of rows to use as a title area\&.  Defaults to 0\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-usecommand\fR
Database Name:	\fBuseCommand\fR
Database Class:	\fBUseCommand\fR

.fi
.IP
A boolean value which specifies whether to use the \fBcommand\fR option\&.
This value sets itself to zero if \fBcommand\fR is used and returns an error\&.
Defaults to 1 (will use \fBcommand\fR if specified)\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-validate\fR
Database Name:	\fBvalidate\fR
Database Class:	\fBValidate\fR

.fi
.IP
A boolean specifying whether validation should occur for the active buffer\&.
Defaults to 0\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-validatecommand or -vcmd\fR
Database Name:	\fBvalidateCommand\fR
Database Class:	\fBValidateCommand\fR

.fi
.IP
Specifies a command to execute when the active cell is edited\&.  This command
is expected to return a TCL boolean\&.  If it returns true, then it is assumed
the new value is OK, otherwise the new value is rejected (the edition will
not take place)\&.  Errors in this command are handled in the background\&.  It
uses the % substitution model described in \fBCOMMAND SUBSTITUTION\fR below\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-variable\fR
Database Name:	\fBvariable\fR
Database Class:	\fBVariable\fR

.fi
.IP
Specifies name of TCL array variable to use for table data storage\&.  It will
be created if it doesn't already exist or is a simple variable\&. The default is
\fB::tableData\fR\&. The array keys are of the form \fIrow\fR,\fIcol\fR for cells
and the special key \fBactive\fR which contains the value of the active cell
buffer\&.  The TCL array is managed as a sparse array (the table does not require
that all valid indices have values)\&.  No stored value for an index is
equivalent to the empty string, and clearing a cell will remove that index
from the TCL array, unless the \fB-sparsearray\fR options is set to 0\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-width\fR
Database Name:	\fBwidth\fR
Database Class:	\fBWidth\fR

.fi
.IP
Specifies the desired width for the window, in columns\&.
If zero or less, then the desired width for the window is made just
large enough to hold all the columns in the table\&.  The width can be
further limited by \fB-maxwidth\fR\&.
.LP
.nf
.ta 6c
Command-Line Switch:	\fB-wrap\fR
Database Name:	\fBwrap\fR
Database Class:	\fBWrap\fR

.fi
.IP
Specifies the default wrap value for tags\&.  Defaults to 0\&.
.PP
.SH INITIALIZATION
.PP
When the \fBtable\fR command is loaded into an interpreter, a built-in
TCL command, \fBtkTableInit\fR, is evaluated\&.  This will search for the
appropriate table binding init file to load\&.  The directories searched
are those in \fB$::tcl_pkgPath\fR, both with Tktable(version) appended and
without, \fB$::tk_library\fR and \fB[pwd]\fR (the current directory)\&.  You
can also define an \fB$::env(TK_TABLE_LIBRARY)\fR to head this search list\&.
By default, the file searched for is called "\fItkTable\&.tcl\fR", but this
can be overridden by setting \fB$::env(TK_TABLE_LIBRARY_FILE)\fR\&.
.PP
This entire init script can be overridden by providing your own
\fBtkTableInit\fR procedure before the library is loaded\&.  Otherwise, the
aforementioned \fB::env(TK_TABLE_LIBRARY)\fR variable will be set with the
directory in which \fB$::env(TK_TABLE_LIBRARY_FILE)\fR was found\&.
.SH INDICES
.PP
Many of the widget commands for tables take one or more indices as arguments\&.
An index specifies a particular cell of the table, in any of
the following ways:
.TP
\fB\fInumber\fR\fB,\fR\fInumber\fR\fR
Specifies the cell as a numerical index of row,col which corresponds to the
index of the associated TCL array, where \fB-roworigin,-colorigin\fR
corresponds to the first cell in the table (0,0 by default)\&.  The values
for row and column will be constrained to actual values in the table,
which means a valid cell is always found\&.
.TP
\fBactive\fR
Indicates the cell that has the keyboard input focus and cursor\&.
It is set by the \fBactivate\fR widget command\&.
.TP
\fBanchor\fR
Indicates the cell with the selection anchor point\&. It is set by the
\fBselection anchor\fR widget command\&.
.TP
\fBbottomright\fR
Indicates the bottom-right most cell currently visible in the table\&.
.TP
\fBend\fR
Indicates the bottom right cell of the table\&.
.TP
\fBfocus\fR
Indicates the cell that has the keyboard navigation focus\&.
It is set by the \fBfocus\fR widget command\&.
.TP
\fBorigin\fR
Indicates the top-leftmost editable cell of the table, not necessarily
in the display\&.  This takes into account the user specified origin and
title area\&.
.TP
\fBtopleft\fR
Indicates the top-left most editable cell currently visible in the table,
excluding the title cells\&.
.TP
\fB@\fIx\fR\fB,\fR\fIy\fR\fR
Indicates the cell that covers the point in the table window
specified by \fIx\fR and \fIy\fR (in pixel coordinates)\&.  If no
cell covers that point, then the closest cell to that
point is used\&.
.PP
.PP
In the widget command descriptions below, arguments named \fIindex\fR,
\fIfirst\fR, and \fIlast\fR always contain cell indices in one of
the above forms\&.
.SH "ACTIVE CELL INDEX"
.PP
Several of the widget commands use an index for the position of the text in the
active cell\&. The valid forms are:
.TP
\fB\fInumber\fR\fR
The position in the text starting from 0 to the last character\&.
Use 0 for before the first character\&.
.TP
\fBend\fR
The position after the last character in the text
.TP
\fBinsert\fR
The current insertion index set by \fBicursor\fR\&.
.PP
.SH TAGS
.PP
A tag is a textual string that is associated with zero or more rows,
columns or cells in a table\&.  Tags may contain arbitrary characters, but it
is probably best to avoid using names which look like indices to reduce
coding confusion\&.  A tag can apply to an entire row or column, or just a
single cell\&.  There are several permanent tags in each table that can be
configured by the user and will determine the attributes for special cells\&.
They are in default priority order:
.TP
\fBflash\fR
If flash mode is on, this tag is associated with any recently edited cells\&.
.TP
\fBactive\fR
This tag is associated with the \fBactive\fR cell\&.
.TP
\fBfocus\fR
This tag is associated with the \fBfocus\fR cell\&.
.TP
\fBsel\fR
This tag is associated with all selected cells\&.
.TP
\fBtitle\fR
This tag is associated with all title row and column cells\&.
This tag has \fB-state\fR \fBdisabled\fR by default\&.
.PP
.PP
Tags control the way cells are displayed on the screen\&.  Where appropriate,
the default for displaying cells is determined by the options for the table
widget\&.  However, display options may be associated with individual tags
using \fBtag configure\fR widget command\&.  If a cell, row or column has
been tagged, then the display options associated with the tag override the
default display style\&.  The following options are currently supported for tags:
.TP
\fB-anchor\fR \fIanchor\fR
Defines how to position text or image within a cell\&. Must be one of
the values \fBn\fR, \fBne\fR, \fBe\fR, \fBse\fR, \fBs\fR, \fBsw\fR,
\fBw\fR, \fBnw\fR, or \fBcenter\fR\&. Defaults to \fBcenter\fR\&.
.TP
\fB-background or -bg\fR \fIcolor\fR
Background color of the cell\&. May also be the empty string to inherit the
default table background value (the default)\&.
.TP
\fB-borderwidth or -bd\fR \fIpixelList\fR
Borderwidth of the cell using same format for the table\&. May also be the
empty string to inherit the default table borderwidth value (the default)\&.
.TP
\fB-ellipsis\fR \fIstring\fR
String to display at the end of a line that would be clipped by its cell,
like "\&.\&.\&."\&.  An ellipsis will be displayed only on non-wrapping, non-multiline
cells that would be clipped\&. The ellipsis will display on the left for east
anchored cells, otherwise it displays on the right\&. May also be the
empty string to inherit the default table ellipsis value (the default)\&.
.TP
\fB-font\fR \fIfontName\fR
Font for text in the cell\&. May also be the
empty string to inherit the default table font value (the default)\&.
.TP
\fB-foreground or -fg\fR \fIcolor\fR
Foreground color of the cell\&. May also be the
empty string to inherit the default table foreground value (the default)\&.
.TP
\fB-justify\fR \fIjustify\fR
When there are multiple lines of text displayed in a cell, this option
determines how the lines line up with each other\&. Must be one of \fBleft\fR,
\fBcenter\fR, or \fBright\fR\&. The default is \fBleft\fR\&. Left means
that the lines' left edges all line up, center means that the lines' centers
are aligned, and right means that the lines' right edges line up\&.
.TP
\fB-image\fR \fIimageName\fR
An image to display in the cell instead of text or empty string for none
(default)\&.
.TP
\fB-multiline\fR \fIboolean\fR
Whether to display text with newlines on multiple lines\&. May also be the
empty string to inherit the default table multiline value (the default)\&.
.TP
\fB-relief\fR \fIrelief\fR
The relief for the cell\&. Values are: \fBflat\fR, \fBgroove\fR,
\fBraised\fR, \fBridge\fR, \fBsolid\fR, and \fBsunken\fR\&.
May also be the
empty string to inherit the default table relief value (the default)\&.
.TP
\fB-showtext\fR \fIboolean\fR
Whether to show the text over an image\&. May also be the
empty string to inherit the default table showtext value (the default)\&.
.TP
\fB-state\fR \fIstate\fR
The state of the cell, to allow for certain cells to be disabled\&. Uses the same
values as the table state\&. This prevents the cell from being edited by the
\fBinsert\fR or \fBdelete\fR methods, but a direct \fBset\fR will
not be prevented\&.
.TP
\fB-wrap\fR \fIboolean\fR
Whether characters should wrap in a cell that is not wide enough\&. May also be the
empty string to inherit the default table wrap value (the default)\&.
.PP
.PP
A priority order is defined among tags based on creation order (first
created tag has highest default priority), and this order is used in
implementing some of the tag-related functions described below\&.  When a cell
is displayed, its properties are determined by the tags which are assigned
to it\&.  The priority of a tag can be modified by \fBtag lower\fR and
\fBtag raise\fR widget commands\&.
.PP
If a cell has several tags associated with it that define the same display
options (eg - a \fBtitle\fR cell with specific \fBrow\fR and \fBcell\fR
tags), then the options of the highest priority tag are used\&.  If a
particular display option hasn't been specified for a particular tag, or if
it is specified as an empty string {}, then that option will not be used; the
next highest priority tag's option will be used instead\&.  If no tag
specifies a particular display option, then the default style for the
widget will be used\&.
.PP
Images are used for display purposes only\&.  Editing in that cell will still
be enabled and any querying of the cell will show the text value of the cell,
regardless of the value of \fB-showtext\fR\&.
.SH "EMBEDDED WINDOWS"
.PP
There may be any number of embedded windows in a table widget (one per
cell), and any widget may be used as an embedded window (subject to the
usual rules for geometry management, which require the table window to be
the parent of the embedded window or a descendant of its parent)\&.  The
embedded window's position on the screen will be updated as the table is
modified or scrolled, and it will be mapped and unmapped as it moves into
and out of the visible area of the table widget\&.  Each embedded window
occupies one cell's worth of space in the table widget, and it is referred
to by the index of the cell in the table\&.  Windows associated with the
table widget are destroyed when the table widget is destroyed\&.
.PP
Windows are used for display purposes only\&.  A value still exists for that
cell, but will not be shown unless the window is deleted in some way\&.  If
the window is destroyed or lost by the table widget to another geometry
manager, then any data associated with it is lost (the cell it occupied
will no longer appear in \fBwindow names\fR)\&.
.PP
When an embedded window is added to a table widget with the window
configure widget command, several configuration options may be associated
with it\&.  These options may be modified with later calls to the window
configure widget command\&.  The following options are currently supported:
.TP
\fB-create\fR \fIscript\fR
NOT CURRENTLY SUPPORTED\&.  Specifies a TCL script that may be evaluated to
create the window for the annotation\&.  If no \fB-window\fR option has been
specified for this cell then this script will be evaluated when the
cell is about to be displayed on the screen\&.  Script must create a
window for the cell and return the name of that window as its result\&.
If the cell's window should ever be deleted, the script will be evaluated
again the next time the cell is displayed\&.
.TP
\fB-background or -bg\fR \fIcolor\fR
Background color of the cell\&.  If not
specified, it uses the table's default background\&.
.TP
\fB-borderwidth or -bd\fR \fIpixelList\fR
Borderwidth of the cell, of the same format for the table, but may also
be an empty string to inherit the default table borderwidth value (the default)\&.
.TP
\fB-padx\fR \fIpixels\fR
As defined in the Tk options man page\&.
.TP
\fB-pady\fR \fIpixels\fR
As defined in the Tk options man page\&.
.TP
\fB-relief\fR \fIrelief\fR
The relief to use for the cell in which the window lies\&.  If not
specified, it uses the table's default relief\&.
.TP
\fB-sticky\fR \fIsticky\fR
Stickiness of the window inside the cell, as defined by the \fBgrid\fR command\&.
.TP
\fB-window\fR \fIpathName\fR
Specifies the name of a window (widget) to display in the annotation\&.  It
must exist before being specified here\&. When an empty string is specified,
if a window was displayed it will cease to be managed by the table widget\&.
.PP
.SH "THE SELECTION"
.PP
Table selections are available as type STRING\&.  By default, the value of
the selection will be the values of the selected cells in nested TCL list
form where each row is a list and each column is an element of a row list\&.
You can change the way this value is interpreted by setting the
\fB-rowseparator\fR and \fB-colseparator\fR options\&.  For example,
default Excel format would be to set \fB-rowseparator\fR to '\\n' and
\fB-colseparator\fR to '\\t'\&.  Changing these values affects both how the
table sends out the selection and reads in pasted data, ensuring that the
table should always be able to cut and paste to itself\&.  It is possible to
change how pastes are handled by editing the table library procedure
\fBtk_tablePasteHandler\fR\&.  This might be necessary if
\fB-selectioncommand\fR is set\&.
.PP
Whenever the selection changes a virtual event <<TableSelect>> is generated\&.
It might also be generated when selection is affected but not actually
changed\&. Further, multiple selection changes could happen before events can
be processed leading to multiple events with the same visible selection\&.
.SH "ROW/COL SPANNING"
.PP
Individual cells can span multiple rows and/or columns\&.  This is done
via the \fBspans\fR command (see below for exact arguments)\&.  Cells in
the title area that span are not permitted to span beyond the title area,
and will be constrained accordingly\&.  If the title area shrinks during a
configure, sanity checking will occur to ensure the above\&.  You may set
spans on regular cells that extend beyond the defined row/col area\&.  These
spans will not be constrained, so that when the defined row/col area
expands, the span will expand with it\&.
.PP
When setting a span, checks are made as to whether the span would overlap
an already spanning or hidden cell\&.  This is an error and it not allowed\&.
Spans can affect the overall speed of table drawing, although not
significantly\&.  If spans are not used, then there is no performance loss\&.
.PP
Cells \fIhidden\fR by spanning cells still have valid data\&.  This will
be seen during cut and paste operations that involve hidden cells, or
through direct access by a command like \fBget\fR or \fBset\fR\&.
.PP
The drawing properties of spanning cells apply to only the visual area
of the cell\&.  For example, if a cell is center justified over 5 columns,
then when viewing any portion of those columns, it will appear centered
in the visible area\&. The non-visible column area will not be considered
in the centering calculations\&.
.SH "COMMAND SUBSTITUTION"
.PP
The table widget supports percent substitutions for several of the command
options using the Tk % substitutions method (see \fBbind\fR for more
details)\&.  The following % substitution sequences are recognized and
substituted by the table widget:
.TP
\fB%c\fR
For \fB-selectioncommand\fR, it is the maximum number of columns in any
row in the selection\&.  Otherwise it is the column of the triggered cell\&.
.TP
\fB%C\fR
A convenience substitution for "\fB%r,%c\fR"\&.
.TP
\fB%i\fR
For \fB-selectioncommand\fR, it is the total number of cells in the selection\&.
For \fB-command\fR, it is 0 for a read (get) and 1 for a write (set)\&.
Otherwise it is the current cursor position in the cell\&.
.TP
\fB%r\fR
For \fB-selectioncommand\fR, it is the number of rows in the selection\&.
Otherwise it is the row of the triggered cell\&.
.TP
\fB%s\fR
For \fB-validatecommand\fR, it is the current value of the cell being validated\&.
For \fB-selectioncommand\fR, it is the default value of the selection\&.
For \fB-browsecommand\fR, it is the index of the last active cell\&.
For \fB-command\fR, it is empty for reads (get) and the current value of the
cell for writes (set)\&.
.TP
\fB%S\fR
For \fB-validatecommand\fR, it is the potential new value of the cell
being validated\&.
For \fB-browsecommand\fR, it is the index of the new active cell\&.
.TP
\fB%W\fR
The pathname to the window for which the command was generated\&.
.PP
.SH "WIDGET COMMAND"
.PP
The \fBtable\fR command creates a new Tcl command whose name is the same as the
path name of the table's window\&. This command may be used to invoke various
operations on the widget\&. It has the following general form:
.CS

\fIpathName\fR \fIoption\fR \fI?arg \&.\&.\&.?\fR
.CE
\fIPathName\fR is the name of the command, which is the same as the table
widget's path name\&. Option and the args determine the exact behavior of the
command\&. The following commands are possible for table widgets:
.TP
\fIpathName\fR \fBactivate\fR ?\fIindex\fR?
Activates cell \fIindex\fR and sets the keyboard input focus to it\&. Once a
cell is active, the insertion cursor will be displayed and all keyboard events
will be directed to that item\&. Activating a cell also sets the \fBfocus\fR
to that cell\&. If \fIindex\fR is set to the empty string {}, then no cell will
be active without changing the focus cell\&. Without \fIindex\fR the current
active cell is returned, if any, otherwise an empty string is returned\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBbbox\fR \fIfirst\fR ?\fIlast\fR?
Returns the bounding box for the specified cell or rectangle of cells as a
4-tuple of x, y, width and height in pixels\&.  When both \fIfirst\fR and
\fIlast\fR are specified, \fIfirst\fR is the top left corner of the rectangle
of cells and \fIlast\fR is the bottom right corner\&. The returned value is
clipped to just the visible portion, if any, otherwise an empty string is
returned\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBborder\fR \fIoption args\fR
This command is a voodoo hack to implement border sizing for tables\&.
This is normally called through bindings, with the following as valid options:
.RS
.TP
\fIpathName\fR \fBborder mark\fR \fIx y\fR ?\fIrow|col\fR?
Records \fIx\fR and \fIy\fR and the row and/or column border under that
point in the table window, if any; used in conjunction with later
\fBborder dragto\fR commands\&.  Typically this command is associated with a
mouse button press in the widget\&.  If \fIrow\fR or \fIcol\fR is not specified,
it returns a tuple of both border indices (an empty string means no border)\&.
Otherwise, just the specified item is returned\&.
.TP
\fIpathName\fR \fBborder dragto\fR \fIx y\fR
This command computes the difference between its \fIx\fR and \fIy\fR arguments
and the \fIx\fR and \fIy\fR arguments to the last \fBborder mark\fR
command for the widget\&.  It then adjusts the previously marked border by the
difference\&.  This command is typically associated with mouse motion events in
the widget, to produce the effect of interactive border resizing\&.
.RE
.TP
\fIpathName\fR \fBcget\fR \fIoption\fR
Returns the current value of the configuration option given
by \fIoption\fR\&.  \fIOption\fR may have any of the values accepted
by the \fBtable\fR command\&.
.TP
\fIpathName\fR \fBclear\fR \fIoption\fR ?\fIfirst\fR? ?\fIlast\fR?
This command is a convenience routine to clear certain state information
managed by the table\&.  \fIfirst\fR and \fIlast\fR represent valid table
indices\&.  If neither are specified, then the command operates on the
whole table\&.  See \fBINDICES\fR for valid forms of index\&.
The following options are recognized:
.RS
.TP
\fIpathName\fR \fBclear cache\fR ?\fIfirst\fR? ?\fIlast\fR?
Clears the specified section of the cache, if the table has been
keeping one\&.
.TP
\fIpathName\fR \fBclear sizes\fR ?\fIfirst\fR? ?\fIlast\fR?
Clears the specified row and column areas of specific height/width
dimensions\&.  When just one index is specified, for example \fB2,0\fR,
that is interpreted as row 2 and column 0\&.
.TP
\fIpathName\fR \fBclear tags\fR ?\fIfirst\fR? ?\fIlast\fR?
Clears the specified area of tags (all row, column and cell tags)\&.
.TP
\fIpathName\fR \fBclear all\fR ?\fIfirst\fR? ?\fIlast\fR?
Performs all of the above clear functions on the specified area\&.
.RE
.TP
\fIpathName\fR \fBconfigure\fR ?\fIoption\fR? ?\fIvalue option value \&.\&.\&.\fR?
Query or modify the configuration options of the widget\&.
If no \fIoption\fR is specified, returns a list describing all of
the available options for \fIpathName\fR (see \fBTk_ConfigureInfo\fR for
information on the format of this list)\&.  If \fIoption\fR is specified
without \fIvalue\fR, then the command returns a list describing the
one named option (this list will be identical to the corresponding
sublist of the value returned if no \fIoption\fR is specified)\&.  If
one or more \fIoption-value\fR pairs are specified, then the command
modifies the given widget option(s) to have the given value(s);  in
this case the command returns an empty string {}\&.
\fIoption\fR may have any of the values accepted by the \fBtable\fR
command\&.
.TP
\fIpathName\fR \fBcurselection\fR ?\fIvalue\fR?
without arguments, returns a sorted list of the currently selected cell
indices, otherwise all the selected cells will be set to \fIvalue\fR\&.  This
has no effect if there is no associated TCL array or the state is disabled\&.
.TP
\fIpathName\fR \fBcurvalue\fR ?\fIvalue\fR?
Sets the current active cell edit buffer to \fIvalue\fR\&.
Without \fIvalue\fR, the current contents of the edit buffer are returned\&.
The edit buffer holds the edited text prior to writing it to the cell\&.
.TP
\fIpathName\fR \fBdelete\fR \fIoption arg\fR ?\fIarg\fR?
This command is used to delete text, columns, and rows\&.
It has several forms, depending on the \fIoption\fR:
.RS
.TP
\fIpathName\fR \fBdelete active\fR \fIstart\fR ?\fIend\fR?
Deletes text in the active cell\&.  With only \fIstart\fR, only the character
after index \fIstart\fR is deleted\&.  With both \fIstart\fR and \fIend\fR, all
characters from index \fIstart\fR to just before index \fIend\fR are deleted\&.
See \fBACTIVE CELL INDEX\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBdelete cols\fR ?\fIswitches\fR? \fIindex\fR ?\fIcount\fR?
.TP
\fIpathName\fR \fBdelete columns\fR ?\fIswitches\fR? \fIindex\fR ?\fIcount\fR?
Delete \fIcount\fR columns at column \fIindex\fR where \fIcount\fR
defaults to 1 (only delete column \fIindex\fR)\&.  The \fIindex\fR will be
constrained to the limits of the table\&.  If \fIcount\fR is negative, then
\fIcount\fR columns to the left of \fIindex\fR will be deleted, otherwise columns
to the right will be deleted\&.  Currently, spans are not adjusted with this action\&.
Optional switches are:
.RS
.TP
\fB-holddimensions\fR
Specifies that the table dimensions not change by replacing deleted columns
with empty columns\&.  By default the dimensions are adjusted by \fIcount\fR\&.
.TP
\fB-holdselection\fR
Specifies that the selection be maintained on the absolute cells values\&.
Otherwise, the selection will be cleared\&.
.TP
\fB-holdtags\fR
Specifies that tags created with the \fBtag\fR method and associated with
the columns and cells not move along with the data\&.  Also prevents specific
widths set by the \fIwidth\fR method from being adjusted\&.  By default, these
tags are properly adjusted\&.
.TP
\fB-holdwindows\fR
Specifies that the embedded windows created with the \fBwindow\fR method to
not move along with the data\&.  By default, these windows are properly adjusted\&.
.TP
\fB-keeptitles\fR
Specifies that title area cells not be changed\&.  Otherwise they are
treated just like regular cells and will move as specified\&.
.TP
\fB--\fR
Signifies the end of the switches\&.
.RE
.TP
\fIpathName\fR \fBdelete rows\fR ?\fIswitches\fR? \fIindex\fR ?\fIcount\fR?
Deletes \fIcount\fR rows at row \fIindex\fR where \fIcount\fR defaults
to 1 (only delete row \fIindex\fR)\&.  If \fIcount\fR is negative, then \fIcount\fR
rows before \fIindex\fR will be deleted, otherwise rows after will be deleted\&.
Will clear the selection\&.  Uses the same switches as \fBdelete columns\fR\&.
.RE
.TP
\fIpathName\fR \fBexport\fR
Get the values from the currently selected cells, join them using the
delimiters \fB-colseparator\fR, \fB-rowseparator\fR, and quote character
\fB-quotechar\fR and return as a string\&. This is used by the
\fBtk_tableCopy\fR command\&.
.TP
\fIpathName\fR \fBfocus\fR ?\fIindex\fR?
Sets the keyboard navigation focus to cell \fIindex\fR\&. Activating a cell also
sets the focus to that cell\&. Setting the focus does not change the active cell\&.
If \fIindex\fR is set to the empty string {}, then no cell will have the focus\&.
Without \fIindex\fR the current focus cell is returned, if any, otherwise an
empty string is returned\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBget\fR \fIfirst\fR ?\fIlast\fR?
Returns the value of the cell \fIfirst\fR or range of cells from \fIfirst\fR
to \fIlast\fR as a list\&. When both \fIfirst\fR and \fIlast\fR are specified,
\fIfirst\fR is the top left corner of the rectangle of cells and \fIlast\fR
is the bottom right corner\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBget2\fR \fIfirst|list\fR ?\fIlast\fR?
Returns the cell values as a list where each list element is a sublist of the
values for that row\&.
With 1 arg, returns the values for the \fIlist\fR of cell indicies\&.
With 2 args, returns the values of the cells within the range where
\fIfirst\fR is the top left corner of the rectangle of cells and \fIlast\fR
is the bottom right corner\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBheight\fR ?\fIrow\fR? ?\fIvalue row value \&.\&.\&.\fR?
If no \fIrow\fR is specified, a list describing all rows for which a height has
been set will be returned\&.  If \fIrow\fR is specified without a value, the height
of that row in characters (positive number) or pixels (negative number) will be
returned\&.  If one or more \fIrow-value\fR pairs are specified, then each row is
set to be that height in lines (positive number) or pixels (negative number)\&.
If \fIvalue\fR is \fIdefault\fR, then the row uses the default height,
specified by \fB-rowheight\fR\&.
.TP
\fIpathName\fR \fBhidden\fR ?\fIindex\fR? ?\fIindex \&.\&.\&.\fR?
Without any args, returns a list of all the \fIhidden\fR cells (those cells
covered by a spanning cell)\&.  If one index is specified, returns the
spanning cell covering that index, if any\&.  If multiple indices are
specified, returns 1 if all indices are hidden cells, 0 if not\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBicursor\fR ?\fIindex\fR?
Sets the insertion cursor position in the active cell to index \fIindex\fR\&.
Without any arguments, the current insertion index is returned\&. If there is
no active cell, or the cell or table is disabled, -1 is returned\&.
See \fBACTIVE CELL INDEX\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBimport\fR ?selection?
Retrieves the value of selection \fIselection\fR (default is \fBCLIPBOARD\fR),
parse it using the delimiters \fB-colseparator\fR, \fB-rowseparator\fR,
and quote character \fB-quotechar\fR and return as a list where each element
is a sublist of the values for that row\&. This is used by the
\fBtk_tablePaste\fR command\&.
.TP
\fIpathName\fR \fBindex\fR \fIindex\fR ?\fBrow|col\fR?
Returns the cell that corresponds to index \fIindex\fR in the form of row,col\&.
If \fBrow\fR or \fBcol\fR is specified, then only the row or column index
is returned\&. If \fIindex\fR does not exist, an error will be returned\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBinsert\fR \fIoption arg arg\fR
This command is used to insert text, columns, and rows\&.
It has several forms, depending on the \fIoption\fR:
.RS
.TP
\fIpathName\fR \fBinsert active\fR \fIindex value\fR
Insert string \fIvalue\fR at index \fIindex\fR in the active cell\&.  The
insertion cursor is then positioned after the inserted text\&.
See \fBACTIVE CELL INDEX\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBinsert cols\fR ?\fIswitches\fR? \fIindex\fR ?\fIcount\fR?
.TP
\fIpathName\fR \fBinsert columns\fR ?\fIswitches\fR? \fIindex\fR ?\fIcount\fR?
Inserts \fIcount\fR columns at column \fIindex\fR where \fIcount\fR
defaults to 1\&.  If \fIcount\fR is negative, the columns are inserted to the
left of column \fIindex\fR, otherwise they are inserted to the right\&.  Will
clear the selection\&. Uses the same switches as \fBdelete columns\fR\&.
.TP
\fIpathName\fR \fBinsert rows\fR ?\fIswitches\fR? \fIindex\fR ?\fIcount\fR?
Inserts \fIcount\fR rows at row \fIindex\fR where \fIcount\fR defaults
to 1\&.  If \fIcount\fR is negative, the rows are inserted before row \fIindex\fR,
otherwise they are inserted after it\&.  Will clear the selection\&.  Uses the same
switches as \fBdelete columns\fR\&.
.RE
.TP
\fIpathName\fR \fBreread\fR
Rereads the old contents of the cell back into the active cell edit buffer\&.
This is useful for a key binding when <Escape> is pressed to abort the edit
(a default binding)\&.
.TP
\fIpathName\fR \fBscan\fR \fIoption args\fR
This command is used to implement scanning on tables\&.  It has
two forms, depending on \fIoption\fR:
.RS
.TP
\fIpathName\fR \fBscan mark\fR \fIx y\fR
Records \fIx\fR and \fIy\fR and the current view in the table
window;  used in conjunction with later \fBscan dragto\fR commands\&.
Typically this command is associated with a mouse button press in
the widget\&.  The return value is an empty string\&.
.TP
\fIpathName\fR \fBscan dragto\fR \fIx y\fR
This command computes the difference between its \fIx\fR and \fIy\fR
arguments and the \fIx\fR and \fIy\fR arguments to the last \fBscan mark\fR
command for the widget\&.  It then adjusts the view by 5 times the difference
in coordinates\&.  This command is typically associated with mouse motion
events in the widget, to produce the effect of dragging the list at high
speed through the window\&.  The return value is an empty string\&.
.RE
.TP
\fIpathName\fR \fBsee\fR \fIindex\fR
Adjust the view in the table so that cell \fIindex\fR is positioned within the
view if the cell is not currently visible on the screen\&. The view will be
shifted left/right or up/down to maintain the current row or column relative
position if \fIindex\fR is in the same row or column\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBselection\fR \fIoption arg\fR
This command is used to adjust the selection within a table\&.  It
has several forms, depending on \fIoption\fR:
.RS
.TP
\fIpathName\fR \fBselection active\fR ?\fIstart\fR? ?\fIend\fR?
Sets the active cell text selection to the characters from index \fIstart\fR to
just before index \fIend\fR\&. Without any arguments, the current start and end
index are returned or an empty string if none\&. If \fIstart\fR equals \fIend\fR
or only \fIstart\fR is provided, the selection is cleared\&.
See \fBACTIVE CELL INDEX\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBselection anchor\fR \fIindex\fR
Sets the selection anchor to cell \fIindex\fR\&.  The selection
anchor is the end of the selection that is fixed while dragging out a
selection with the mouse\&.  The index \fBanchor\fR may be used to refer to
the anchor cell\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBselection clear\fR \fIfirst\fR ?\fIlast\fR?
If any of the cells between \fIfirst\fR and \fIlast\fR (inclusive) are
selected, they are deselected\&.  The selection state is not changed for cells
outside this range\&.  \fIfirst\fR may be specified as \fBall\fR to remove
the selection from all cells\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBselection includes\fR \fIindex\fR
Returns 1 if cell \fIindex\fR is currently selected or 0 if not\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBselection set\fR \fIfirst\fR ?\fIlast\fR?
Selects all of the cells in the range between index \fIfirst\fR and \fIlast\fR,
inclusive, without affecting the selection state of cells outside that range\&.
When both \fIfirst\fR and \fIlast\fR are specified, \fIfirst\fR is the top left
corner of the rectangle of cells and \fIlast\fR is the bottom right corner\&.
Option \fIlast\fR defaults to \fIfirst\fR's value\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBselection size\fR
Returns the number of selected cells\&.
.RE
.TP
\fIpathName\fR \fBset\fR \fBrow|col\fR \fIindex\fR ?\fIvalue\fR? ?\fIindex value \&.\&.\&.\fR?
Sets each cell \fIindex\fR to the following \fIvalue\fR\&.  Table validation will
not be triggered via this method\&.  If \fBrow\fR or \fBcol\fR precedes the
list of index/value pairs, then the value is assumed to be a TCL list whose
values will be split and set into the subsequent columns (if \fBrow\fR is
specified) or rows (for \fBcol\fR)\&.  For example, "\fBset row 2,3 {a b c}\fR"
will set 3 cells, from 2,3 to 2,5, to the specified values\&.  The setting of
cells is silently bounded by the known table dimensions\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBspans\fR ?\fIindex\fR? ?\fIrows,cols index rows,cols \&.\&.\&.\fR?
This command is used to manipulate row/column spans\&.  When called without
arguments, all known spans are returned as a list of tuples of the form
{index span}\&.  When called with only the \fIindex\fR, the span for that
\fIindex\fR only is returned, if any\&.  Otherwise an even number of
\fIindex rows,cols\fR pairs are used to set spans\&.  A span starts at the
\fIindex\fR and continues for the specified number of rows and columns\&.
Negative spans are not supported\&.  A span of 0,0 unsets any span on that
cell\&.  See \fBEXAMPLES\fR for more info\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBtag\fR option ?\fIarg arg \&.\&.\&.\fR?
This command is used to manipulate tags\&.  The exact behavior of the command
depends on the \fIoption\fR argument that follows the \fBtag\fR argument\&.
\fIcget\fR, \fIcell\fR, and \fIrow|col\fR complain about unknown tag names\&.
The following forms of the command are currently supported:
.RS
.TP
\fIpathName\fR \fBtag cell\fR \fItagName ?index \&.\&.\&.?\fR
Apply tag \fItagName\fR to each cell \fIindex\fR replacing any previous cell
tag\&. If \fItagName\fR is {}, the cells are reset to the default tag\&. Without
any arguments, a list of cell indices that use tag \fItagName\fR is returned\&.
Tags added during \fB-coltagcommand\fR or \fB-rowtagcommand\fR evaluation
do not register here\&.  If \fItagName\fR does not exist, it will be created with
the default options\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBtag cget\fR \fItagName option\fR
This command returns the current value of the option named \fIoption\fR
associated with the tag given by \fItagName\fR\&.  \fIOption\fR may have any
of the values accepted by the \fBtag configure\fR widget command\&.
.TP
\fIpathName\fR \fBtag col\fR \fItagName ?col \&.\&.\&.?\fR
.TP
\fIpathName\fR \fBtag column\fR \fItagName ?col \&.\&.\&.?\fR
Applies tag \fItagName\fR to each column \fIcol\fR replacing any previous
column tag\&. If \fItagName\fR is {}, the columns are reset to the default tag\&.
Without any arguments, a list of columns that use tag \fItagName\fR is returned\&.
Tags added during \fB-coltagcommand\fR evaluation do not register here\&.
If \fItagName\fR does not exist, it will be created with the default options\&.
.TP
\fIpathName\fR \fBtag configure\fR \fItagName\fR ?\fIoption\fR? ?\fIvalue\fR? ?\fIoption value \&.\&.\&.\fR?
Query or modify the configuration options of tag \fItagName\fR\&. If no
\fIoption\fR is specified, a list describing all of the available options for
\fItagName\fR ts returned (see \fBTk_ConfigureInfo\fR for info on the format of
this list)\&.  If \fIoption\fR is specified without \fIvalue\fR,
then a list describing option \fIoption\fR is returned (this list will
be identical to the corresponding sublist of the value returned if no
\fIoption\fR is specified)\&.  If one or more \fIoption-value\fR pairs are
specified, then the command modifies the given option(s) to have the given
value(s) in \fItagName\fR and returns an empty string\&. See \fBTAGS\fR
for details on the options available for tags\&.
.TP
\fIpathName\fR \fBtag delete\fR \fItagName\fR \fI?tagName \&.\&.\&.?\fR
Deletes each tag \fItagName\fR\&.  No error if the tag does not exist\&.
.TP
\fIpathName\fR \fBtag exists\fR \fItagName\fR
Returns 1 if the tag \fItagName\fR exists, 0 if not\&.
.TP
\fIpathName\fR \fBtag get\fR \fIindex\fR
Returns list of tags for cell \fIindex\fR\&.
.TP
\fIpathName\fR \fBtag includes\fR \fItagName index\fR
Returns 1 if cell \fIindex\fR has tag \fItagName\fR, 0 if not\&.
.TP
\fIpathName\fR \fBtag lower\fR \fItagName\fR ?\fIbelowThis\fR?
Lower the priority of tag \fItagName\fR\&.  If \fIbelowThis\fR is not specified,
then the tag's priority is lowered to the bottom, otherwise it is lowered
to one below \fIbelowThis\fR\&.
.TP
\fIpathName\fR \fBtag names\fR ?\fIpattern\fR?
If no pattern is specified, returns a list of all defined tag names\&. With
\fIpattern\fR, only those tags that match \fBglob\fR \fIpattern\fR
will be returned\&.  Tag names are returned in priority order
(highest priority tag first)\&.
.TP
\fIpathName\fR \fBtag priority\fR \fItagName\fR
Returns the numeric priority for tag \fItagName\fR\&.
.TP
\fIpathName\fR \fBtag raise\fR \fItagName\fR ?\fIaboveThis\fR?
Raise the priority of tag \fItagName\fR\&.  If \fIaboveThis\fR is not specified,
then the tag's priority is raised to the top, otherwise it is raised to
one above \fIaboveThis\fR\&.
.TP
\fIpathName\fR \fBtag row\fR \fItagName\fR ?\fIrow \&.\&.\&.\fR?
Applies tag \fItagName\fR to each row \fIrow\fR replacing any previous row
tag\&. If \fItagName\fR is {}, the rows are reset to the default tag\&.
Without any arguments, a list of rows that use tag \fItagName\fR is returned\&.
Tags added during \fB-rowtagcommand\fR evaluation do not register here\&.
If \fItagName\fR does not exist, it will be created with the default options\&.
.RE
.TP
\fIpathName\fR \fBvalidate\fR \fIindex\fR
Validate the contents of cell \fIindex\fR using the current
\fB-validatecommand\fR callback and return 1 if valid or 0 if not\&.
See \fBINDICES\fR for valid forms of index\&.
.TP
\fIpathName\fR \fBwidth\fR ?\fIcol\fR? ?\fIvalue col value \&.\&.\&.\fR?
If no \fIcol\fR is specified, a list describing all columns for which a width
has been set will be returned\&.  If \fIcol\fR is specified without a value, the width of
that column in characters (positive number) or pixels (negative number) will be
returned\&.  If one or more \fIcol-value\fR pairs are specified, then each
column is set to be that width in characters (positive number) or pixels
(negative number)\&.  If \fIvalue\fR is \fIdefault\fR, then the column uses the
default width, specified by \fB-colwidth\fR\&.
.TP
\fIpathName\fR \fBwindow\fR option ?\fIarg arg \&.\&.\&.\fR?
This command is used to manipulate embedded windows\&.  The exact behavior of
the command depends on the \fIoption\fR argument that follows the
\fBwindow\fR argument\&.  The following forms of the command are currently
supported:
.RS
.TP
\fIpathName\fR \fBwindow cget\fR \fIindex option\fR
This command returns the current value of the option named \fIoption\fR
associated with the window given by \fIindex\fR\&.  \fIOption\fR may have any
of the values accepted by the \fBwindow configure\fR widget command\&.
.TP
\fIpathName\fR \fBwindow configure\fR \fIindex\fR ?\fIoption\fR? ?\fIvalue\fR? ?\fIoption value \&.\&.\&.\fR?
Query or modify the configuration options of window \fIindex\fR\&. If no
\fIoption\fR is specified, a list describing all of the available options for
\fIindex\fR is returned (see \fBTk_ConfigureInfo\fR for info on the format of
this list)\&. If \fIoption\fR is specified without \fIvalue\fR, then a list
describing the option is returned (this list will be identical to the
corresponding sublist of the value returned if no \fIoption\fR is specified)\&.
If one or more \fIoption-value\fR pairs are specified, then the command modifies
the given option(s) to have the given value(s) in \fIindex\fR and returns an
empty string\&.
See \fBEMBEDDED WINDOWS\fR above for details on the options available for windows\&.
.TP
\fIpathName\fR \fBwindow delete\fR \fIindex\fR ?\fIindex \&.\&.\&.\fR?
Deletes embedded window \fIindex\fR from the table\&.  The associated window will
also be deleted\&.
.TP
\fIpathName\fR \fBwindow move\fR \fIindexFrom indexTo\fR
Moves an embedded window from cell \fIindexFrom\fR to cell \fIindexTo\fR\&.
If a window already exists in the target cell, it will be deleted\&.
.TP
\fIpathName\fR \fBwindow names\fR ?\fIpattern\fR?
If no pattern is specified, returns a list of cell indices with embedded windows\&.
Otherwise the \fIpattern\fR is used as a \fBglob\fR pattern to show only
cells matching that pattern\&.
.RE
.TP
\fIpathName\fR \fBxview\fR \fI?args?\fR
This command is used to query and change the horizontal position of the content
in the widget's window\&. It can take any of the following forms:
.RS
.TP
\fIpathName\fR \fBxview\fR
Returns a list containing two elements\&. Each element is a real fraction
between 0 and 1; together they describe the horizontal span that is visible in
the window\&. For example, if the first element is \&.2 and the second element is
\&.6, 20% of the table's text is off-screen to the left, the middle 40% is
visible in the window, and 40% of the text is off-screen to the right\&. These
are the same values passed to scrollbars via the -xscrollcommand option\&.
.TP
\fIpathName\fR \fBxview\fR \fIindex\fR
Adjusts the view in the window so that the column given by \fIindex\fR is
displayed at the left edge of the window\&.
.TP
\fIpathName\fR \fBxview moveto\fR \fIfraction\fR
Adjusts the view in the window so that \fIfraction\fR of the total width of
the table is off-screen to the left\&. \fIfraction\fR must be a fraction
between 0 and 1\&.
.TP
\fIpathName\fR \fBxview scroll\fR \fInumber what\fR
This command shifts the view in the window left or right according to
\fInumber\fR and \fIwhat\fR\&. \fINumber\fR must be an integer\&.
\fIWhat\fR must be either \fBunits\fR or \fBpages\fR or an abbreviation
of one of these\&.
If \fIwhat\fR is \fBunits\fR, the view adjusts left or right by
\fInumber\fR cells on the display; if it is \fBpages\fR then the view
adjusts by \fInumber\fR screenfuls\&.
If \fInumber\fR is negative then cells farther to the left
become visible;  if it is positive then cells farther to the right
become visible\&.
.RE
.TP
\fIpathName\fR \fByview\fR \fI?args?\fR
This command is used to query and change the vertical position of the
rows in the widget's window\&.  It can take any of the following forms:
.RS
.TP
\fIpathName\fR \fByview\fR
Returns a list containing two elements\&. Each element is a real fraction between
0 and 1; together they describe the vertical span that is visible in the window\&.
The first element gives the position of the table element at the top of the
window, relative to the table as a whole (0\&.5 means it is halfway through the
table, for example)\&. The second element gives the position of the table element
just after the last one in the window, relative to the table as a whole\&. These
are the same values passed to scrollbars via the -yscrollcommand option\&.
.TP
\fIpathName\fR \fByview\fR \fIindex\fR
Adjusts the view in the window so that the row given by \fIindex\fR is
displayed at the top of the window\&.
.TP
\fIpathName\fR \fByview moveto\fR \fIfraction\fR
Adjusts the view in the window so that the element given by \fIfraction\fR
appears at the top of the window\&.
\fIFraction\fR is a fraction between 0 and 1;  0 indicates the first
element in the table, 0\&.33 indicates the element one-third the
way through the table, and so on\&.
.TP
\fIpathName\fR \fByview scroll\fR \fInumber what\fR
This command adjusts the view in the window up or down according to
\fInumber\fR and \fIwhat\fR\&.  \fINumber\fR must be an integer\&.  \fIWhat\fR
must be either \fBunits\fR or \fBpages\fR\&.  If \fIwhat\fR is \fBunits\fR,
the view adjusts up or down by \fInumber\fR cells; if it is \fBpages\fR then
the view adjusts by \fInumber\fR screenfuls\&.  If \fInumber\fR is negative
then earlier elements become visible; if it is positive then later elements
become visible\&.
.RE
.PP
.SH "DEFAULT BINDINGS"
.PP
The default class bindings are:
.IP [1]
If \fB-mode\fR is \fBtable\fR, pressing Button-1 in a cell will activate
that cell and move the insertion cursor to the character nearest the mouse
pointer\&. If \fB-mode\fR is \fBspreadsheet\fR, pressing Button-1 in a cell
will only focus that cell for keyboard navigation\&. A Double-Button-1 will be
needed to activate it and move the insertion cursor to the character nearest
the mouse\&. For either mode, if \fB-selectmode\fR is not \fBmultiple\fR,
all other cells are unselected\&.
.IP [2]
Moving the mouse while Button-1 is pressed will extend the character selection
in the active cell, if any, or extend the cell selection area if
\fB-selectmode\fR is \fBextended\fR\&.
Exiting the window while Button-1 is pressed, will cause scanning to occur on
the table along with extending the selection\&. Re-entering the window will
terminate the scanning\&.
.IP [3]
A Double-Button-1 in the active cell will select the underlying word\&.
.IP [4]
A Triple-Button-1 in the active cell will select all text in the cell\&.
.IP [5]
Moving the mouse while Button-2 is pressed causes scanning to
occur without any selection\&.
.IP [6]
Moving the mouse while Button-3 (the right button on Windows) is pressed
while you are over a border will cause interactive resizing of that row
and/or column to occur, based on the value of \fB-resizeborders\fR\&.
.IP [7]
The left, right, up, and down arrow keys move to the next cell in that
direction\&.
.IP [8]
When \fB-selectmode\fR is \fBextended\fR, Shift and the left, right, up
and down arrow keys extend the selection one cell in that direction\&.
.IP [9]
Control (or Option on Mac) and the left, right, up, and down arrow keys move to
the first/last visible cell in that row or column\&.
.IP [10]
When \fB-selectmode\fR is \fBextended\fR, Control (or Option on Mac) plus
Shift and the left, right, up, and down arrow keys extend the selection to the
first/last visible column or row in that direction\&.
.IP [11]
Home moves to the first cell in the current row\&.
.IP [12]
End moves to the last cell in the current row\&.
.IP [13]
When \fB-selectmode\fR is \fBextended\fR, Shift-Home selects all cells
from the current cell to the first cell in the current row\&.
.IP [14]
When \fB-selectmode\fR is \fBextended\fR, Shift-End selects all cells
from the current cell to the last cell in the current row\&.
.IP [15]
Control-Home moves to the \fBorigin\fR cell\&.
.IP [16]
Control-End moves to the \fBend\fR cell\&.
.IP [17]
Shift-Control-Home extends the selection to the \fBorigin\fR cell\&.
.IP [18]
Shift-Control-End extends the selection to the \fBend\fR cell\&.
.IP [19]
Next or Prior (aka Page Down or Page Up) will move one screen-full down or up\&.
.IP [20]
Shift-Next or Shift-Prior will move one screen-full right or left\&.
.IP [21]
Control-Next or Control-Prior will move to the bottom or top cell in the
current column\&.
.IP [22]
Control-Shift-Next or Control-Shift-Prior will move to the last or first cell
in the row\&.
.IP [23]
When \fB-selectmode\fR is \fBextended\fR or \fBmultiple\fR, Control-slash
(Command-a on Mac) selects all the cells in the table\&.
.IP [24]
When \fB-selectmode\fR is \fBextended\fR or \fBmultiple\fR, Control-backslash
(except on Mac) unselects all cells in the table\&.
.IP [25]
When \fB-selectmode\fR is \fBextended\fR or \fBmultiple\fR, Shift-space
will select all cells in the current row\&.
.IP [26]
When \fB-selectmode\fR is \fBextended\fR or \fBmultiple\fR, Control-space
will select all cells in the current column\&.
.IP [27]
Control-Return will toggle whether the cell is activated or just has the focus\&.
.IP [28]
ScrollLock and the left, right, up, and down arrow keys will scroll the xview
or yview by 1 unit in that direction\&.
.IP [29]
ScrollLock-Home or ScrollLock-End will scroll the xview by 1 page left or right\&.
.IP [30]
ScrollLock-Prior or ScrollLock-Next will scroll the yview by 1 page up or down\&.
.IP [31]
ScrollLock-Control-Home or ScrollLock-Control-End will scroll the xview to the
0\&.0 or 1\&.0 position\&.
.IP [32]
ScrollLock-Control-Prior or ScrollLock-Control-Next will scroll the yview to the
0\&.0 or 1\&.0 position\&.
.IP [33]
The virtual event <<Copy>> will copy the contents of the selected cells to the
clipboard\&.
.IP [34]
The virtual event <<Cut>> will copy the contents of the selected cells to the
clipboard and clear the cells\&.
.IP [35]
The virtual event <<Paste>> will paste the clipboard contents into the
table cells\&.
.PP
.PP
When a cell is active, the following bindings are available in addition to or
in place of the above bindings:
.IP [1]
The left or right arrow keys will move the insertion cursor left or right one
character\&. If already at the first or last character, the cell to left or right
will be activated and the insertion cursor set to after the last or before the
first character, respectively\&.
.IP [2]
The up and down arrow keys will move to and activate the above or below
cell and put the insertion cursor at the same location in the new cell\&.
.IP [3]
Home moves the insertion cursor to the beginning of the active cell\&.
.IP [4]
End moves the insertion cursor to the end of the active cell\&.
.IP [5]
Backspace deletes the selected text or if none the character before the
insertion cursor in the active cell\&.
.IP [6]
Delete deletes the selected text or if none the character after the insertion
cursor in the active cell\&.
.IP [7]
Return accepts any changes made to the cell and activates the below cell\&.
.IP [8]
Shift-Return accepts any changes made to the cell and activates the above cell\&.
.IP [9]
Tab accepts any changes made to the cell and activates the cell to the
right of the current cell\&.
.IP [10]
Shift-Tab accepts any changes made to the cell and activates the cell to
the left of the current cell\&.
.IP [11]
Alt-Return inserts a newline character\&.
.IP [12]
Escape rereads the value of the active cell from the specified data source,
discarding any edits that have may been performed on the cell\&.
.IP [13]
Control-a moves the insertion cursor to the beginning of the active cell\&.
.IP [14]
Control-e moves the insertion cursor to the end of the active cell\&.
.IP [15]
Control-i inserts a tab character\&.
.IP [16]
Control-k deletes from the insertion cursor to the end of the active cell\&.
.IP [17]
Control-minus and Control-equals decrease and increase the
width of the column with the active cell in it\&.
.IP [18]
The virtual event <<Copy>> will copy the selected text in the active cell to
the clipboard\&.
.IP [19]
The virtual event <<Cut>> will copy the selected text in the active cell to
the clipboard and clear the selected text\&.
.IP [20]
The virtual event <<Paste>> will paste the clipboard contents into the active
cell at the insertion cursor location replacing any selected text\&.
.PP
Some bindings may have slightly different behavior dependent on the
\fB-selectionmode\fR of the widget\&.
.PP
If the widget is disabled using the \fB-state\fR option, then its
view can still be adjusted and cells can still be selected,
but no insertion cursor will be displayed and no cell modifications will
take place\&.
.PP
The behavior of tables can be changed by defining new bindings for
individual widgets or by redefining the class bindings\&. See the
tkTable\&.tcl file in the same directory as the library\&.
.SH "PERFORMANCE ISSUES"
.PP
The number of rows and columns or a table widget should not significantly
affect the speed of redraw\&.  Recalculation and redraw of table parameters
and cells is restricted as much as possible\&.
.PP
The display cell with the insert cursor is redrawn each time the cursor
blinks, which causes a steady stream of graphics traffic\&.  Set the
\fB-insertofftime\fR option to 0 avoid this\&.  The use of a \fB-command\fR
with the table without a cache can cause significant slow-down, as the
command is called once for each request of a cell value\&.
.SH EXAMPLES
.PP
Set the topleft title area to be one spanning cell\&.  This overestimates both
row and column span by one, but the command does all the constraining for us\&.
.CS

$table span [$table cget -roworigin],[$table cget -colorigin] [$table cget -titlerows],[$table cget -titlecols]
.CE
Force a table window refresh (useful for the slight chance that a bug in the
table is not causing proper refresh):
.CS


$table configure -padx [$table cget -padx]

.CE
.SH "SEE ALSO"
widget
