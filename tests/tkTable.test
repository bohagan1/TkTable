	list [.table xview] [.table yview]
    } -result {{0.88 1.0} {0.69 1.0}}

test See-29.10 {X scroll right} -setup {
	.table activate 25,25
	.table xview moveto 0.25
	.table yview moveto 0.25
	.table see active
    } -body {
	set list [list [.table index topleft] [.table index bottomright]]
	.table activate 25,75
	.table see active
	lappend list [.table index topleft] [.table index bottomright]
	set list
    } -result {25,25 56,37 25,64 56,76}

test See-29.11 {Y scroll down} -setup {
	.table activate 25,25
	.table xview moveto 0.25
	.table yview moveto 0.25
	.table see active
    } -body {
