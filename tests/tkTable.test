test Focus-16.17 {Normal state} -setup {
	.table configure -state normal
    } -body {
	.table focus 9,9
	.table focus
    } -cleanup {
	.table focus {}
    } -result {9,9}

test Focus-16.18 {Set callback} -body {
	.table configure -browsecommand "store_val %c %C %i %r %s %S %W"
    }

test Focus-16.19 {Eval callback activate} -body {
	.table focus 7,2
	set ::temp
    } -result {2 7,2 0 7 {} 7,2 .table}

test Focus-16.20 {Eval callback deactivate} -body {
	.table focus ""
	set ::temp
    } -result {-1 -1,-1 0 -1 7,2 {} .table}

test Focus-16.21 {Callback alias} -body {
