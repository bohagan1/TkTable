proc get_data {w cdelim rdelim quote} {
    set result ""
    foreach line [$w get2 [$w curselection]] {
	set data ""
	foreach value $line {
	    if {[string first $cdelim $value] > -1 || [string first $rdelim $value] > -1 || [string first $quote $value] > -1} {
		append data $quote [string map [list $quote $quote$quote] $value] $quote $cdelim
	    } else {
		append data $value $cdelim
	    }
	}
	append result [string range $data 0 end-1] $rdelim
    }
    return $result
}


