proc tag_test {w opt def set_val get_val} {
    set res 0

    # Default value
    set g [$w tag cget testTag $opt]
    set s [lindex [$w tag configure testTag $opt] 3]
    incr res [expr {[string match $def $s] && $s == $g}]

    # Set and get value
    $w tag configure testTag $opt $set_val
    set s [lindex [$w tag configure testTag $opt] 4]
    set g [$w tag cget testTag $opt]
    incr res [expr {$s == $get_val && $s == $g}]
    return $res
}

