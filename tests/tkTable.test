	.table activate 75,25
	.table see active
	lappend list [.table index topleft] [.table index bottomright]
	set list
    } -result {25,25 56,37 45,25 76,37}

test See-29.12 {X scroll right and Y scroll down} -setup {
	.table activate 25,25
	.table xview moveto 0.25
	.table yview moveto 0.25
	.table see active
    } -body {
