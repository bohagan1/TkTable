# Set


test Set-42.1 {Create} -body {
	setup_data .table
    } -result {.table}

test Set-42.2 {Too few args} -body {
	.table set
    } -result {wrong # args: should be ".table set ?row|col? index ?value? ?index value ...?"} -returnCodes {1}

test Set-42.3 {Invalid arg count} -body {
	.table set 0,0 val 1,1
    } -result {wrong # args: should be ".table set ?row|col? index ?value? ?index value ...?"} -returnCodes {1}

test Set-42.4 {Invalid index} -body {
	.table set bogus
    } -result {bad table index "bogus": must be active, anchor, end, focus, origin, topleft, bottomright, @x,y, or <row>,<col>} -returnCodes {1}

test Set-42.5 {Set cell vakue} -body {
	.table set 2,2 test
    }

test Set-42.6 {Get cell value} -body {
	.table set 2,2
    } -result {test}

test Set-42.7 {Set multiple cells} -body {
	.table set 3,4 val1 3,5 val2 3,6 val3
	.table set 3,6
    } -result {val3}

test Set-42.8 {Set invalid row} -body {
	.table set row bogus [list 1 2 3]
    } -result {bad table index "bogus": must be active, anchor, end, focus, origin, topleft, bottomright, @x,y, or <row>,<col>} -returnCodes {1}

test Set-42.9 {Set row} -body {
	.table set row 5,0 [list a b c d]
	.table set 5,3
    } -result {d}

test Set-42.10 {Set invalid column} -body {
	.table set col bogus [list 1 2 3]
    } -result {bad table index "bogus": must be active, anchor, end, focus, origin, topleft, bottomright, @x,y, or <row>,<col>} -returnCodes {1}

test Set-42.11 {Set column} -body {
	.table set col 0,4 [list f g h i]
	.table set 3,4
    } -result {i}

test Set-42.12 {Out of range} -body {
	.table set 15,1 val4
    }

test Set-42.13 {Clipped row} -body {
	.table set row 8,0 [list a b c d e f g h I j k l]
	.table set 8,10
    } -result {j}

test Set-42.14 {Clipped column} -body {
	.table set col 0,9 [list a b c d e f g h I j k l]
	.table set 10,9
    } -result {j}

test Set-42.15 {Readonly state} -setup {
	.table configure -state readonly
    } -body {
	.table set 7,5 "New value"
	.table get 7,5
    } -cleanup {
	.table configure -state normal
    }

test Set-42.16 {Disabled state} -setup {
	.table configure -state disabled
    } -body {
	.table set 7,5 "New value"
	.table get 7,5
    } -cleanup {
	.table configure -state normal
    }

test Set-42.17 {Normal state} -setup {
	.table configure -state normal
    } -body {
	.table set 7,5 "New value"
	.table get 7,5
    } -cleanup {
	.table configure -state normal
    } -result {New value}
# Check if variable trace updated hash table per Bug #487747

test Set-42.18 {Variable trace} -body {
	.table set 7,7 "New value"
	set tableData(7,7)
    } -result {New value}

test Set-42.19 {Cleanup} -body {
	destroy .table
    }

# Spans


test Spans-43.1 {Create} -body {
	setup_data .table
    } -result {.table}

test Spans-43.2 {Wrong num of args} -body {
	.table spans 1 2 3
    } -result {wrong # args: should be ".table spans ?index? ?rows,cols index rows,cols ...?"} -returnCodes {1}

test Spans-43.3 {Invalid index} -body {
	.table spans bogus
    } -result {bad table index "bogus": must be active, anchor, end, focus, origin, topleft, bottomright, @x,y, or <row>,<col>} -returnCodes {1}

test Spans-43.4 {Default} -body {
	.table spans
    }

test Spans-43.5 {Set} -body {
	.table spans 5,5 3,2
    }

test Spans-43.6 {Get} -body {
	.table spans 5,5
    } -result {3,2}

test Spans-43.7 {Get All} -body {
	.table spans
    } -result {5,5 3,2}

test Spans-43.8 {Clear} -body {
	.table spans 5,5 0,0
	.table spans 5,5
    }

test Spans-43.9 {Set Multiple} -body {
	.table spans 1,1 3,2 1,5 3,3 1,9 5,1
	lsort -stride 2 -index 0 [.table spans]
    } -result {1,1 3,2 1,5 3,3 1,9 5,1}

test Spans-43.10 {Clear All} -body {
	.table spans 1,1 0,0 1,5 0,0 1,9 0,0
	lsort -stride 2 -index 0 [.table spans]
    }

test Spans-43.11 {Negative size} -body {
	.table spans 5,5 -2,-2
	.table spans 5,5
    }

test Spans-43.12 {Hidden cell} -setup {
	.table spans 8,1 0,5
    } -body {
	.table spans 8,2 2,2
    } -cleanup {
	.table spans 8,1 0,0
    } -result {cannot set spanning on hidden cell 8,2} -returnCodes {1}
# Spans does not constrain span to visible cells

test Spans-43.13 {Out of range min} -body {
	.table spans -1,-1 2,2
	lsort -stride 2 -index 0 [.table spans]
    } -cleanup {
	.table spans -1,-1 0,0
    } -result {0,0 2,2}

test Spans-43.14 {Out of range max} -body {
	.table spans 1,9 2,2
	lsort -stride 2 -index 0 [.table spans]
    } -cleanup {
	.table spans 1,9 0,0
    } -result {1,9 2,2}

test Spans-43.15 {Beyond range min} -body {
	.table spans -5,-5 2,2
	lsort -stride 2 -index 0 [.table spans]
    } -cleanup {
	.table spans -5,-5 0,0
    } -result {0,0 2,2}

test Spans-43.16 {Beyond range max} -body {
	.table spans 15,15 3,3
	lsort -stride 2 -index 0 [.table spans]
    } -cleanup {
	.table spans 15,15 0,0
    } -result {9,9 3,3}

test Spans-43.17 {Empty table} -setup {
	.table configure -cols 0 -rows 0
    } -body {
	.table spans 1,1 2,2
	lsort -stride 2 -index 0 [.table spans]
    } -cleanup {
	.table spans 1,1 0,0
    } -result {0,0 2,2}

test Spans-43.18 {Cleanup} -body {
	destroy .table
    }

