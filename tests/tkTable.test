# Auto generated test cases for tkTable.csv

# Load Tcl Test package
if {[lsearch [namespace children] ::tcltest] == -1} {
	package require tcltest
	namespace import ::tcltest::*
}

set auto_path [concat [list [file dirname [file dirname [info script]]]] $auto_path]

package require Tktable

# Constraints
::tcltest::testConstraint  tcl8 [expr {[info tclversion] < 9.0}]
::tcltest::testConstraint  tcl9 [expr {[info tclversion] >= 9.0}]

# Helper functions
proc setup {w args} {
    set tb [table $w {*}$args]
    grid $w
    tkwait visibility $w
    return $w
}

set table_data [list [list "abc" "a b c" " a b c "] [list "d\te" "d\te\tf" "\td\te\tf\t"] [list "g\n" "g\n\nh" "\ng\nh\n"] [list "\"hij\"" "h\"i\"j" "\nhij\n"] [list \u2020\u2021\u2022 "\u2023 \u2024" "\u2025\n\u2026"] [list 1,2 3,4 5,6]]
proc setup_data {w args} {
    table $w {*}$args
    grid $w
    tkwait visibility $w
    set row -1
    foreach line $::table_data {
	$w set row [incr row],0 $line
    }
    return $w
}

proc store_val {args} {set ::temp $args;return 1}
proc pause {{ms 1000}} {set ::pause 0;after $ms [list set ::pause 1];vwait ::pause}

# Widget


test Table-1.1 {Defaults} -body {
	table .table
	list [winfo exists .table] [winfo class .table] [info commands .table]
    } -cleanup {
	destroy .table
    } -result {1 Table .table}

test Table-1.2 {Too few args} -body {
	table
    } -result {wrong # args: should be "table pathName ?options?"} -returnCodes {1}

test Table-1.3 {Invalid Path} -body {
	table bogus
    } -result {bad window path name "bogus"} -returnCodes {1}

test Table-1.4 {Invalid Arg} -body {
	table .table -bogus value
    } -result {unknown option "-bogus"} -returnCodes {1}

test Table-1.5 {No option} -setup {
	table .table
    } -body {
	.table
    } -cleanup {
	destroy .table
    } -result {wrong # args: should be ".table option ?arg arg ...?"} -returnCodes {1}

test Table-1.6 {Invalid Option} -setup {
	table .table
    } -body {
	.table bogus
    } -cleanup {
	destroy .table
    } -result {bad option "bogus": must be activate, bbox, border, cget, clear, configure, curselection, curvalue, delete, export, focus, get, get2, height, hidden, icursor, import, index, insert, reread, scan, see, selection, set, spans, tag, validate, version, window, width, xview, or yview} -returnCodes {1}

test Table-1.7 {Ambiguous Option} -setup {
	table .table
    } -body {
	.table c
    } -cleanup {
	destroy .table
    } -result {ambiguous option "c": must be activate, bbox, border, cget, clear, configure, curselection, curvalue, delete, export, focus, get, get2, height, hidden, icursor, import, index, insert, reread, scan, see, selection, set, spans, tag, validate, version, window, width, xview, or yview} -returnCodes {1}

