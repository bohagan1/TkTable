# Delete Active
set string "This is some text"


test Delete_Active-13.1 {Create} -body {
	setup .table
    } -result {.table}

test Delete_Active-13.2 {Too few args} -body {
	.table delete active
    } -result {wrong # args: should be ".table delete option ?switches? arg ?arg?"} -returnCodes {1}

