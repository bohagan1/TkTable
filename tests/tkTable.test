	.table see bogus
    } -result {bad table index "bogus": must be active, anchor, end, focus, origin, topleft, bottomright, @x,y, or <row>,<col>} -returnCodes {1}

test See-29.5 {Cell visible} -body {
	.table see 6,6
	list [.table xview] [.table yview]
    } -result {{0.0 0.12903225806451613} {0.0 0.3157894736842105}}

test See-29.6 {Cell Not visible} -body {
	.table see 21,21
	list [.table xview] [.table yview]
    } -result {{0.1 0.22903225806451613} {0.0 0.3157894736842105}}

test See-29.7 {Active} -setup {
	.table activate 50,50
    } -body {
	.table see active
	list [.table xview] [.table yview]
    } -result {{0.39 0.5190322580645161} {0.2 0.5157894736842106}}

