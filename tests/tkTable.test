	lsort -integer [.table tag row testTag]
    } -result {1 2}

test Tag_Row-59.6 {Add tag to multiple} -body {
	.table tag row testTag 3 4 5 6
	lsort -integer [.table tag row testTag]
    } -result {1 2 3 4 5 6}

test Tag_Row-59.7 {Get list} -body {
	lsort -integer [.table tag row testTag]
    } -result {1 2 3 4 5 6}

test Tag_Row-59.8 {Clear tag} -body {
