    }

test Selection_Anchor-32.7 {Get} -body {
	.table index anchor
    } -result {3,3}

test Selection_Anchor-32.8 {Clear} -body {
	.table selection anchor {}
    }

test Selection_Anchor-32.9 {Out of range min} -body {
	.table selection anchor -5,-5
	.table index anchor
    } -result {0,0}

test Selection_Anchor-32.10 {Out of range max} -body {
