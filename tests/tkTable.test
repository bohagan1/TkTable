# Curselection


test Curselection-10.1 {Create} -body {
	setup .table
    } -result {.table}

test Curselection-10.2 {Too many args} -body {
	.table curselection 1 2
    } -result {wrong # args: should be ".table curselection ?value?"} -returnCodes {1}

test Curselection-10.3 {Default} -body {
	.table curselection
    }

test Curselection-10.4 {Get} -setup {
	.table selection set 2,2 3,3
    } -body {
	.table curselection
    } -result {2,2 2,3 3,2 3,3}

test Curselection-10.5 {Over write} -body {
	.table curselection "Test value"
	.table get 2,3
    } -result {Test value}

test Curselection-10.6 {Use negative indices} -body {
	.table configure -colorigin -5 -roworigin -5
    }

test Curselection-10.7 {Get with negative indices} -setup {
	.table selection set -2,-2 3,3
    } -body {
	.table curselection
    } -result "-2,-2 -2,-1 -2,0 -2,1 -2,2 -2,3 -1,-2 -1,-1 -1,0 -1,1 -1,2 -1,3 0,-2 0,-1 0,0 0,1 0,2 0,3 1,-2 1,-1 1,0 1,1 1,2 1,3 2,-2 2,-1 2,0 2,1 2,2 2,3 3,-2 3,-1 3,0 3,1 3,2 3,3"

test Curselection-10.8 {Reset} -body {
	.table selection clear all
    }

test Curselection-10.9 {Readonly state} -setup {
	.table configure -state readonly
	.table selection set 0,0
    } -body {
	.table curselection
    } -cleanup {
	.table configure -state normal
	.table selection clear all
    } -result {0,0}

test Curselection-10.10 {Disabled state} -setup {
	.table configure -state disabled
	.table selection set 0,0
    } -body {
	.table curselection
    } -cleanup {
	.table configure -state normal
	.table selection clear all
    }

test Curselection-10.11 {Normal state} -setup {
	.table configure -state normal
	.table selection set 0,0
    } -body {
	.table curselection
    } -cleanup {
	.table configure -state normal
	.table selection clear all
    } -result {0,0}

test Curselection-10.12 {Cleanup} -body {
	destroy .table
    }

