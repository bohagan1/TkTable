	.table delete active bogus value
    } -result {expected integer but got "bogus"} -returnCodes {1}

test Delete_Active-13.5 {Init} -body {
	.table activate 3,7
    }

test Delete_Active-13.6 {Delete at  0} -setup {
	.table set 3,7 $string
    } -body {
	.table delete active 0
	.table curvalue
    } -result {his is some text}

test Delete_Active-13.7 {Delete range at  0} -setup {
	.table set 3,7 $string
    } -body {
	.table delete active 0 5
	.table curvalue
    } -result {is some text}

test Delete_Active-13.8 {Delete in middle} -setup {
	.table set 3,7 $string
    } -body {
	.table delete active 5
	.table curvalue
    } -result {This s some text}

test Delete_Active-13.9 {Delete range in middle} -setup {
	.table set 3,7 $string
    } -body {
	.table delete active 4 6
	.table curvalue
    } -result {Thiss some text}

test Delete_Active-13.10 {Delete at  8} -setup {
	.table set 3,7 $string
    } -body {
	.table delete active 8
	.table curvalue
    } -result {This is ome text}

test Delete_Active-13.11 {Delete range at  8} -setup {
	.table set 3,7 $string
    } -body {
	.table delete active 8 12
	.table curvalue
    } -result {This is  text}

test Delete_Active-13.12 {Delete at end} -setup {
	.table set 3,7 $string
    } -body {
	.table delete active end
	.table curvalue
    } -result {This is some text}

test Delete_Active-13.13 {Delete range at  end} -setup {
	.table set 3,7 $string
    } -body {
	.table delete active 15 17
	.table curvalue
    } -result {This is some te}

test Delete_Active-13.14 {Delete before} -setup {
	.table set 3,7 $string
    } -body {
	.table delete active -5 5
	.table curvalue
    } -result {is some text}

test Delete_Active-13.15 {Delete after} -setup {
	.table set 3,7 $string
    } -body {
	.table delete active 15 25
	.table curvalue
    } -result {This is some te}

test Delete_Active-13.16 {Empty cell} -setup {
	.table set 3,7 {}
    } -body {
	.table delete active 5 10
	.table curvalue
    }

test Delete_Active-13.17 {Readonly state} -setup {
	.table set 3,7 $string
	.table configure -state readonly
    } -body {
	.table delete active 5 10
	.table curvalue
    } -result {This is some text}

test Delete_Active-13.18 {Disabled state} -setup {
	.table configure -state disabled
    } -body {
	.table delete active 5 10
	.table get 3,7
    } -result {This is some text}

test Delete_Active-13.19 {Normal state} -setup {
	.table configure -state normal
    } -body {
	.table delete active 5 10
	.table curvalue
    } -result {This me text}

