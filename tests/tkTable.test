	.table configure -bg
    } -match {glob} -result "-background background Background * blue"

test Configure-7.8 {Cleanup} -body {
	destroy .table
    }

proc cfg_test {w opt def set_val get_val} {
    set res 0

    # Default value
    set g [$w cget $opt]
    set orig $g
    set s [lindex [$w configure $opt] 3]
    incr res [expr {[string match $def $s] && $s == $g}]

    # Set and get value
    $w configure $opt $set_val
    set s [lindex [$w configure $opt] 4]
    set g [$w cget $opt]
    incr res [expr {$s == $get_val && $s == $g}]
    $w configure $opt $orig
    return $res
}

proc null {args} {}

