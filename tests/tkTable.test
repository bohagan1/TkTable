proc keypress {w event} {if {[focus] ne $w} {focus -force $w};event generate $w $event -when now;pause 50}
proc do_event {w event} {focus -force $w;event generate $w $event;pause 50}

# Active Cell Edit


test Binding_Cell_Edit-38.1 {Create} -body {
	setup .table -cols 50 -rows 50
    } -result {.table}

test Binding_Cell_Edit-38.2 {Init} -body {
	.table set row 0,0 [list abcd efgh ijkl]
	.table set row 1,0 [list mnop qrst uvw\nxyz]
    }

test Binding_Cell_Edit-38.3 {Move left 1 char} -setup {
	.table activate 1,1
	.table icursor 2
    } -body {
	keypress .table <<PrevChar>>
